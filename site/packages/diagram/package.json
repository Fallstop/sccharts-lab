{
  "name": "@sccharts-lab/diagram",
  "version": "0.1.0",
  "description": "SCCharts diagrams in KIELER's notation: ELK layout and SVG rendering for charts compiled with @sccharts-lab/engine, in Node and the browser",
  "keywords": ["sccharts", "kieler", "diagram", "svg", "elk", "elkjs", "graph-layout", "statecharts", "visualization"],
  "homepage": "https://sccharts.jmw.nz",
  "bugs": "https://github.com/Fallstop/sccharts-lab/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fallstop/sccharts-lab.git",
    "directory": "site/packages/diagram"
  },
  "license": "EPL-2.0 AND OFL-1.1",
  "type": "module",
  "sideEffects": ["*.css"],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts",
    "./diagram.css": "./src/diagram.css",
    "./*": "./src/*.ts"
  },
  "files": ["dist"],
  "dependencies": {
    "elkjs": "0.12.0"
  },
  "peerDependencies": {
    "@sccharts-lab/engine": "workspace:*"
  },
  "devDependencies": {
    "@sccharts-lab/engine": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "./layout": { "types": "./dist/layout.d.ts", "default": "./dist/layout.js" },
      "./render": { "types": "./dist/render.d.ts", "default": "./dist/render.js" },
      "./highlight": { "types": "./dist/highlight.d.ts", "default": "./dist/highlight.js" },
      "./types": { "types": "./dist/types.d.ts", "default": "./dist/types.js" },
      "./diagram.css": "./dist/diagram.css",
      "./fonts.css": "./dist/fonts.css",
      "./package.json": "./package.json"
    }
  }
}
