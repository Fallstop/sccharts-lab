// A sum or difference as KIELER writes it into C, `x = 2000000000 + (i + 2000000000)`. KIELER runs it: x is 0,
// -294967296, -294967295.
scchart Main { input bool b input int i int a[2] = {4,7} int c[2] = {4,7} int m[2][2] = {{4,7},{8,1}} float fa[2] bool ba[2] output int x output float f output bool y initial state A do x = 2000000000 + (i + 2000000000) go to A }
