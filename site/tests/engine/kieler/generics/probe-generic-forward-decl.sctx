// A generic chart hands its parameter on in a ref declaration's arguments after the chart (ref Inner<M> g): KIELER
// does not replace it there.
scchart D06 {
  output int p
  initial state S is D06M<4>(p)
}
scchart D06M<M is int> {
  output int o
  ref D06G<M> g(o)
}
scchart D06G<N is int> {
  output int o = 0
  initial state A do o += N go to A
}
