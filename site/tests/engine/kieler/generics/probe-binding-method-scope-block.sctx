// An input bound to a variable, hidden by a block's variable inside the block only.
scchart Main { output int p int v = 5 initial state S is G(v, p) }
scchart G {
  input int N
  output int o
  method int get() { int r = 0 { int N = 7 r = N } return r * 100 + N }
  initial state A do o = get() go to A
}
