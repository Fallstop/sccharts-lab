// An input bound to a variable, named in the initial value of a method's local: not replaced, and the input is
// gone.
scchart Main { output int p int v = 5 initial state S is G(v, p) }
scchart G {
  input int N
  output int o
  method int get() { int x = N return x }
  initial state A do o = get() go to A
}
