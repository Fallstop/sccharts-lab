// The parameter stands for a variable: the nested chart's local N is that variable.
scchart G09 {
  output int p
  output int k = 2
  initial state S is G09O<k>(p)
}
scchart G09O<N is int> {
  output int o
  initial state T is G09I(o)
}
scchart G09I {
  output int o = 0
  int N = 100
  initial state A do o += N; N += 1 go to A
}
