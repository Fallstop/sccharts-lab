// A wrong generic argument on extends in a chart the simulated chart does not use: accepted, KIELER only checks it
// when it compiles the chart.
scchart H16 {
  output int o = 0
  initial state A do o += 1 go to A
}
scchart H16U extends H16G<true> {
}
scchart H16G<N is int> {
  output int o = 0
  initial state A do o += N go to A
}
