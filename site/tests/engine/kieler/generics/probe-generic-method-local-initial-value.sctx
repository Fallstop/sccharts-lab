// A generic parameter as the initial value of a method's local: KIELER's walk does not visit the initial values of
// the declarations in a body, so N keeps pointing at the parameter that is gone.
scchart Main { output int p initial state S is G<5>(p) }
scchart G<N is int> {
  output int o
  method int get() { int x = N return x }
  initial state A do o = get() go to A
}
