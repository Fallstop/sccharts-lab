// A dataflow instance whose declaration hands on the chart's parameter after the chart (ref Inner<M> g): not
// replaced.
scchart K05 {
  output int p
  initial state S is K05M<4>(p)
}
scchart K05M<M is int> {
  output int o
  ref K05G<M> g
  dataflow { o = g.o }
}
scchart K05G<N is int> {
  output int o = 0
  initial state A do o += N go to A
}
