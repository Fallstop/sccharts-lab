// Two nested blocks each declare the name: the innermost wins, and each ends with its block.
scchart Main { output int p initial state S is G<5>(p) }
scchart G<N is int> {
  output int o
  method int get() { int r = 0 { int N = 7 { int N = 8 r = N } r = r * 10 + N } return r * 100 + N }
  initial state A do o = get() go to A
}
