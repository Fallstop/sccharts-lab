// A variable declared in a for loop's body ends with the loop.
scchart Main { output int p initial state S is G<5>(p) }
scchart G<N is int> {
  output int o
  method int get() { int r = 0 for (int i = 0; i < 2; i++) { int N = 4 r += N } return r * 100 + N }
  initial state A do o = get() go to A
}
