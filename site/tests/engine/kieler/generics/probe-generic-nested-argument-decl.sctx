// ref W w where the chart given for W carries its own generic argument.
scchart X25c {
  output int p
  initial state S is X25cH<X25cBox<4> >(p)
}
scchart X25cH<W is X25cBox> {
  output int q
  ref W w
  dataflow { q = w.o }
}
scchart X25cBox<N is int> {
  output int o = 0
  initial state A do o += N go to A
}
