// The first region's trigger reads the input that the second region assigns in its first tick: the assigning region
// is scheduled first and is part of the GO block.
scchart Main {
  input int i
  input bool c
  output int o, y
  region { initial state A if i > 3 do y += 1 go to A2 state A2 }
  region { initial state P { entry do i = 5; o = i } go to Q state Q }
}
