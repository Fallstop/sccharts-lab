// Two scheduled calls of one C function at priority 1, commuting.
scchart B32 {
  output int o
  schedule {conflicting, commuting} s
  method void f() { for (int i = 0; i < 2; i++) { o += 1 } }
  region R1 { initial state A do f() schedule s 1 go to B state B }
  region R2 { initial state C do f() schedule s 1 go to D state D }
}
