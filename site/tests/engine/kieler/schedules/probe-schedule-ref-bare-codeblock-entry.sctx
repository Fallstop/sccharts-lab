// An entry action with a code block of a chart used as a class with a clause naming the chart's own schedule.
scchart Test {
  output int o
  ref Sub x
  initial state A do o = 1 go to B state B
}
scchart Sub {
  schedule s
  int v
  entry do { v = 1 schedule s 0 }
  initial state P do v = 2 schedule s 1 go to Q state Q
}
