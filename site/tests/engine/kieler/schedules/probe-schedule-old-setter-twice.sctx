// The variable named twice (x = x + x) is no old-style update: a conflict.
scchart Legacy {
  output int x = 1
  output bool f = false
  schedule s
  region W {
    initial state A
    do x = x + x schedule s 0 go to A
  }
  region R {
    initial state B
    do x = x + 2 schedule s 0 go to B
  }
}
