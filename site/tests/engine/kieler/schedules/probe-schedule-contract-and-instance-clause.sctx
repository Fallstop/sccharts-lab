// A contract and a clause naming the instance's schedule.
scchart C21 {
  output int o
  class C {
    schedule s
    int v = 0
    int get() schedule s 1 { return v }
  } c
  region R1 { initial state A do o = c.get() go to B state B }
  region R2 { initial state C2 do c.v = 3 schedule c.s 0 go to D state D }
}
