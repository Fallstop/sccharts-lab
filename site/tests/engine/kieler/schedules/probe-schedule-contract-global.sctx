// A class schedule with a name string, global and a protocol list.
scchart C23 {
  output int o
  class C {
    schedule "name" global commuting {conflicting, commuting} s
    int v = 0
    void set(int x) schedule s 0 { v = x }
    int get() schedule s 1 { return v }
  } c
  region R1 { initial state A do o = c.get() go to B state B }
  region R2 { initial state C2 do c.set(5) go to D state D }
}
