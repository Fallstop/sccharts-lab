// A contract method called in a print.
scchart E20 {
  output int o
  class C {
    schedule s
    int v = 0
    void set(int x) schedule s 1 { v = x }
    int get() schedule s 0 { return v }
  } c
  region R1 { initial state A do print(c.get()); o = 1 go to B state B }
  region R2 { initial state C2 do c.set(5) go to D state D }
}
