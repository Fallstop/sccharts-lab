// A bool parameter of a referenced chart tested alone keeps the trigger's schedule through the binding.
scchart T {
  output bool x
  output int m = 0
  initial state W is Inner(x, m)
}
scchart Inner {
  output bool p
  output int n
  schedule s
  region R1 {
    initial state A schedule s 1 {}
    do p = !p go to A
  }
  region R2 {
    initial state B
    if p schedule s 0 do n++ go to B
  }
}
