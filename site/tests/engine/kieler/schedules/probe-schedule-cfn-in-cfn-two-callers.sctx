// Two C functions that both call a third with a scheduled statement, concurrently.
scchart B53 {
  output int o
  schedule {commuting} s
  method void inner() { for (int i = 0; i < 1; i++) { o += 1 schedule s 0 } }
  method void one() { for (int i = 0; i < 1; i++) { inner() } }
  method void two() { for (int i = 0; i < 1; i++) { inner() } }
  region R1 { initial state A do one() go to B state B }
  region R2 { initial state C do two() go to D state D }
}
