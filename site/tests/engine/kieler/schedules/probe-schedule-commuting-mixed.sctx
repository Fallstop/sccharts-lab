// += and = of one variable at a commuting priority 1: KIELER's check for shorthand operators reads priority 1 as a
// relative write and makes the pair a write-write conflict: rejected.
scchart SchCommMixed {
  output int w = 1
  schedule {conflicting, commuting} s
  region A {
    initial state A
    do w += 1 schedule s 1 go to A
  }
  region B {
    initial state B
    do w = 2 schedule s 1 go to B
  }
}
