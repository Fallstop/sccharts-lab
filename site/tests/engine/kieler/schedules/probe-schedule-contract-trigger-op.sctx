// A contract method called inside a trigger with an operator.
scchart C13 {
  output int o
  class C {
    schedule s
    int v = 0
    void set(int x) schedule s 0 { v = x }
    int get() schedule s 1 { return v }
  } c
  region R1 { initial state A if c.get() > 0 do o = 1 go to B state B }
  region R2 { initial state C2 do c.set(5) go to D state D }
}
