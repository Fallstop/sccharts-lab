// Class methods declared with a schedule (contracts): get at priority 0, set at 1.
scchart SClassMethodsRev {
  output int o
  class C {
    schedule s
    int v = 0
    void set(int x) schedule s 1 { v = x }
    int get() schedule s 0 { return v }
  } c
  region R1 { initial state A immediate do o = c.get() go to B state B }
  region R2 { initial state C2 immediate do c.set(5) go to D state D }
}
