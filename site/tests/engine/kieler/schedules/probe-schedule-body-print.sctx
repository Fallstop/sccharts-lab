// A scheduled print and postfix inside a method.
scchart A10 {
  output int o
  schedule s
  method void setIt() { print("x") schedule s 1; o++ schedule s 1 }
  region R1 { initial state A immediate do setIt() go to B state B }
  region R2 { initial state C immediate do o = 2 schedule s 0 go to D state D }
}
