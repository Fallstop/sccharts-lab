// A C function of a class writes its own member in a statement that calls a contract method of another object, next to a concurrent read of that member.
scchart B42 {
  output int o
  class D { schedule s int w = 0 void set() schedule s 0 { w = 5 } int get() schedule s 1 { return w } } d
  class C { int v void big() { for (int i = 0; i < 1; i++) { v = d.get() } } int own() { return v } } c
  region R1 { initial state A do c.big() go to B state B }
  region R2 { initial state C2 do d.set() go to D2 state D2 }
  region R3 { initial state E do o = c.own() go to G state G }
}
