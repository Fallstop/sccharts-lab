// A contract method two calls deep in a local variable's initial value: both outer calls are C functions.
scchart T {
  output int o
  class C { schedule s int get() schedule s 0 { return 3 } } c
  method int wrap(int x) {
    for (int i = 0; i < 1; i++) { x += 1 }
    return x
  }
  initial state A do { int k = wrap(wrap(c.get())); o = k } go to B state B
}
