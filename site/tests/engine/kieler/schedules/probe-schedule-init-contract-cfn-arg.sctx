// A contract method that is a C function, in an argument of a short method that is an initial value.
scchart T {
  output int o
  class C { schedule s int get() schedule s 0 { int r = 0; for (int i = 0; i < 1; i++) { r = 3 } return r } } c
  method int id(int x) { return x }
  initial state A do { int k = id(c.get()); o = k } go to B state B
}
