// A C function of the chart assigns the value of a contract method (priority 0) next to a concurrent call of another contract method of the object (priority 1) (a reviewer's chart).
scchart T {
  output int o
  class C { schedule s int v = 3 int get() schedule s 0 { return v } void set() schedule s 1 { v = 5 } } c
  method void wrap(int a, int b) { for (int i = 0; i < 1; i++) { o = a } }
  method int plus(int a, int b) { int r = 0; for (int i = 0; i < 1; i++) { r = a } return r }
  method void run() { for (int i = 0; i < 1; i++) { o = c.get() } }
  region R { initial state A do run() go to B state B }
  region S { initial state X do c.set() go to Y state Y }
}
