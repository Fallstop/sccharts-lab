// A scheduled trigger that calls a C function: accepted (a short method there is refused).
scchart B18 {
  output int o
  int x
  schedule s
  method bool pos() { bool r = false; for (int i = 0; i < 2; i++) { r = x > 0 } return r }
  region R1 { initial state A immediate if pos() schedule s 1 do o = 1 go to B state B }
  region R2 { initial state C immediate do x = 2 schedule s 0 go to D state D }
}
