// A signal of the base chart tested alone in the extending chart keeps the trigger's schedule: the test (priority 0) never sees the emission (priority 1).
scchart Base {
  output signal S
  output int n = 0
  schedule s
  region R1 {
    initial state A schedule s 1 {}
    do S go to A
  }
}
scchart T extends Base {
  region R2 {
    initial state B
    if S schedule s 0 do n++ go to B
  }
}
