// A signal parameter of a referenced chart tested alone: the schedule is lost after the binding as well.
scchart T {
  output signal x
  output int m = 0
  initial state W is Inner(x, m)
}
scchart Inner {
  output signal p
  output int n
  schedule s
  region R1 {
    initial state A schedule s 1 {}
    do p go to A
  }
  region R2 {
    initial state B
    if p schedule s 0 do n++ go to B
  }
}
