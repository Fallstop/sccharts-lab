// A scheduled call of a C function with += inside against += at priority 1: the body is not scheduled, and the call is an assignment with =.
scchart B10 {
  output int o
  schedule {commuting, commuting} s
  method void bump() { for (int i = 0; i < 2; i++) { o += 1 } }
  region R1 { initial state A immediate do bump() schedule s 1 go to B state B }
  region R2 { initial state C immediate do o += 2 schedule s 1 go to D state D }
}
