// Two scheduled calls without arguments of one C function at one commuting priority.
scchart B31 {
  output int o
  schedule {commuting} s
  method void f() { for (int i = 0; i < 2; i++) { o += 1 } }
  region R1 { initial state A do f() schedule s 0 go to B state B }
  region R2 { initial state C do f() schedule s 0 go to D state D }
}
