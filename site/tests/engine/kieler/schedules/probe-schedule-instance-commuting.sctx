// An instance schedule with a commuting priority: two writes at that priority are fine.
scchart D09 {
  output int o
  class C { schedule {commuting} s  int v = 0 } c
  region R1 { initial state A do o = 1 schedule c.s 0 go to B state B }
  region R2 { initial state C2 do o = 2 schedule c.s 0 go to D state D }
}
