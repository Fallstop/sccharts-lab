// The same with a schedule nothing names.
scchart GsArr {
  input int x
  output int o
  ref GsArrBox g[2]
  region R1 { initial state A do o = g[0].get() go to A }
  region R2 { initial state C do g[0].set(x) go to C }
}
scchart GsArrBox {
  schedule s
  int v
  method void set(int a) { v = a * 2 }
  method int get() { return v }
}
