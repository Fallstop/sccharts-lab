// A scheduled condition inside a C function that calls a short method of a class.
scchart T {
  output int o
  schedule s
  class C { bool yes() { return true } } c
  method void inner() {
    for (int i = 0; i < 1; i++) {
      if c.yes() schedule s 0 { o = 1 }
    }
  }
  initial state A do inner() go to B state B
}
