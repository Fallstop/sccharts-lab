// A clause naming a variable that is no schedule, in a C function called only from a state that is never entered.
scchart Test {
  output int o
  int s
  method void inner() { for (int i = 0; i < 1; i++) { o = 1 schedule s 0 } }
  initial state A do o = 2 go to B state B
  state X do inner() go to B
}
