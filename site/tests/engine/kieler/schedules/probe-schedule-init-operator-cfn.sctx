// A contract method called in an argument of a C function inside an operator of a local variable's initial value.
scchart T {
  output int o
  class C { schedule s int get() schedule s 0 { return 3 } } c
  method int wrap(int x) {
    for (int i = 0; i < 1; i++) { x += 1 }
    return x
  }
  initial state A do { int k = wrap(c.get()) + 1; o = k } go to B state B
}
