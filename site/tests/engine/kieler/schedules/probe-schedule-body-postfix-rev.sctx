// A scheduled print and postfix inside a method (priorities the other way round).
scchart A11 {
  output int o
  schedule s
  method void setIt() { o++ schedule s 0 }
  region R1 { initial state A immediate do setIt() go to B state B }
  region R2 { initial state C immediate do o = 2 schedule s 1 go to D state D }
}
