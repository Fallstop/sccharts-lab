// A conflicting priority of the schedule of a chart used as a class: two writes at one priority.
scchart Test {
  output int o
  ref Sub x
  region R { initial state A do o = 1 schedule x.s 0 go to B state B }
  region S { initial state C do o = 2 schedule x.s 0 go to D state D }
}
scchart Sub { schedule s }
