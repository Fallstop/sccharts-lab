// A clause naming the schedule of a chart used as a class next to a contract of that chart.
scchart Test {
  output int o
  ref Sub x
  region R { initial state A do o = x.v schedule x.s 1 go to B state B }
  region S { initial state C do x.set() go to D state D }
}
scchart Sub { schedule s int v method void set() schedule s 0 { v = 5 } }
