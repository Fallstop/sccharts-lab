// A contract call next to an emission, and a contract method emitting nothing but read by a signal trigger.
scchart G10 {
  output signal int S
  output int o
  class C {
    schedule s
    int v = 0
    void set(int x) schedule s 0 { v = x }
    int get() schedule s 1 { return v }
  } c
  region R1 { initial state A do S(c.get()) go to B state B }
  region R2 { initial state C2 do c.set(5) go to D state D }
  region R3 { initial state E if S do o = val(S) go to F state F }
}
