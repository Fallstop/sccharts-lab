// A contract method in an argument of a C function as an initial value: the contract still orders the block.
scchart T {
  output int o
  class C { schedule s int v = 3 int get() schedule s 1 { return v } void set() schedule s 0 { v = 7 } } c
  method int wrap(int x) {
    for (int i = 0; i < 1; i++) { x += 1 }
    return x
  }
  region R { initial state A do { int k = wrap(c.get()); o = k } go to B state B }
  region S { initial state C do c.set() go to D state D }
}
