// Two scheduled assignments of one variable whose values call one C function, at one commuting priority.
scchart B35 {
  output int o
  schedule {commuting} s
  method int f(int a, int b) { int r = 0; for (int i = 0; i < 2; i++) { r = a + b } return r }
  region R1 { initial state A do o = f(1, 0) schedule s 0 go to B state B }
  region R2 { initial state C do o = f(1, 0) schedule s 0 go to D state D }
}
