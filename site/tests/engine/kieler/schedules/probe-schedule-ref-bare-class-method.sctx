// A method of a class inside a chart used as a class names the chart's schedule in a statement.
scchart Test {
  output int o
  ref Sub x
  initial state A do o = 1 go to B state B
}
scchart Sub {
  schedule s
  int v
  class K { int w void put() { w = 1 schedule s 0 } } k
  initial state P do k.put() go to Q state Q
}
