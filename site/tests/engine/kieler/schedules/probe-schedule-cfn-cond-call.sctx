// A scheduled condition that calls a short method, inside a method KIELER keeps as a C function: refused (found by a review).
scchart T {
  output int o
  schedule s
  method bool yes() { return true }
  method void inner() {
    for (int i = 0; i < 1; i++) {
      if yes() schedule s 0 { o = 1 }
    }
  }
  initial state A do inner() go to B state B
}
