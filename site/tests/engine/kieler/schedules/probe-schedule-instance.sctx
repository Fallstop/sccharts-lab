// The schedule of a class instance (schedule c.s 1) on writes of a member.
scchart SInstance {
  output int o
  class C { schedule s  int v = 0 } c
  region R1 { initial state A immediate do c.v = 1 schedule c.s 1 go to B state B }
  region R2 { initial state C2 immediate do c.v = 2 schedule c.s 0 go to D state D do o = c.v go to D }
}
