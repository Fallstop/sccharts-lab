// A contract method called in a statement of a chart method.
scchart F12 {
  output int o
  class C {
    schedule s
    int v = 0
    void set(int x) schedule s 1 { v = x }
    int get() schedule s 0 { return v }
  } c
  method void rd() { o = c.get() }
  region R1 { initial state A do rd() go to B state B }
  region R2 { initial state C2 do c.set(5) go to D state D }
}
