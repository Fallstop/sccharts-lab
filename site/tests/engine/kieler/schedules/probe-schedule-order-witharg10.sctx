// A C function of the chart passes the value of a contract method (priority 1) to a C function in a call statement, next to a concurrent contract call (priority 0) (a reviewer's chart).
scchart T {
  output int o
  class C { schedule s int v = 3 int get() schedule s 1 { return v } void set() schedule s 0 { v = 5 } } c
  method void wrap(int a, int b) { for (int i = 0; i < 1; i++) { o = a } }
  method int plus(int a, int b) { int r = 0; for (int i = 0; i < 1; i++) { r = a } return r }
  method void run() { for (int i = 0; i < 1; i++) { wrap(c.get(), 0) } }
  region R { initial state A do run() go to B state B }
  region S { initial state X do c.set() go to Y state Y }
}
