// A contract method called as a whole trigger.
scchart C14 {
  output int o
  class C {
    schedule s
    bool v = false
    void set(bool x) schedule s 0 { v = x }
    bool get() schedule s 1 { return v }
  } c
  region R1 { initial state A if c.get() do o = 1 go to B state B }
  region R2 { initial state C2 do c.set(true) go to D state D }
}
