// Contract methods of two instances at one priority: two schedules, no order.
scchart F14 {
  output int o
  class C {
    schedule s
    int v = 0
    void set(int x) schedule s 0 { v = x }
    int get() schedule s 0 { return v }
  } c, d
  region R1 { initial state A do o = c.get() go to B state B }
  region R2 { initial state C2 do d.set(5) go to D state D }
}
