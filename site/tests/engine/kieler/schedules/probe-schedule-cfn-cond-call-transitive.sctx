// A scheduled condition that calls a short method, inside a C function called by another C function.
scchart T {
  output int o
  schedule s
  method bool yes() { return true }
  method void inner() {
    for (int i = 0; i < 1; i++) {
      if yes() schedule s 0 { o = 1 }
    }
  }
  method void outer() { for (int i = 0; i < 1; i++) { inner() } }
  initial state A do outer() go to B state B
}
