// A chart used as a class declared in an inner state: its schedule named through the instance.
scchart Test {
  output int o
  initial state P {
    ref Sub x
    region R { initial state A do o = 1 schedule x.s 1 go to B state B }
    region S { initial state C do o = 2 schedule x.s 0 go to D state D }
  }
}
scchart Sub { schedule s }
