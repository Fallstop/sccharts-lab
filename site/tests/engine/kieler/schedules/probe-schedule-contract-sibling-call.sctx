// A method that calls a sibling with a contract.
scchart C12 {
  output int o
  class C {
    schedule s
    int v = 0
    void set(int x) schedule s 0 { v = x }
    void both(int x) { set(x) }
    int get() schedule s 1 { return v }
  } c
  region R1 { initial state A do o = c.get() go to B state B }
  region R2 { initial state C2 do c.both(5) go to D state D }
}
