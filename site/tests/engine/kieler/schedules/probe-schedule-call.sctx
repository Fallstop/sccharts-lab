// A schedule on a call effect of a short method (no argument): the body's assignment gets it.
scchart SCall {
  output int o
  schedule s
  method void setIt() { o = 1 }
  region R1 { initial state A immediate do setIt() schedule s 1 go to B state B }
  region R2 { initial state C immediate do o = 2 schedule s 0 go to D state D }
}
