// A scheduled trigger that is a call of a C function alone.
scchart B44 {
  output int o
  int x
  schedule s
  method bool pos() { bool r = false; for (int i = 0; i < 2; i++) { r = x > 0 } return r }
  region R1 { initial state A if pos() schedule s 0 do o = 1 go to B state B }
  region R2 { initial state C do x = 2 schedule s 1 go to D state D }
}
