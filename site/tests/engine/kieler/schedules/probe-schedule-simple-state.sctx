// A schedule on a simple state goes to its outgoing transitions.
scchart SchSimpleState {
  output int o
  schedule s
  region R1 {
    initial state A schedule s 1 {
    }
    immediate do o = 1 go to B
    state B
  }
  region R2 {
    initial state C
    immediate do o = 2 schedule s 0 go to D
    state D
  }
}
