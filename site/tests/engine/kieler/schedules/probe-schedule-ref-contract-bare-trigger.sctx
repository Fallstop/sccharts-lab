// A transition of a chart used as a class tests the chart's contract method, called by its name alone.
scchart Test {
  output int o
  ref Sub x
  initial state A do o = 1 go to B state B
}
scchart Sub {
  schedule s
  int v
  method int get() schedule s 0 { return v }
  initial state P if get() == 0 do v = 1 go to Q state Q
}
