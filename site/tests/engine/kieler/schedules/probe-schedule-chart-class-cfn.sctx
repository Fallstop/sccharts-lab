// A chart used as a class whose contract methods are C functions: ordered through the instance.
scchart H05 {
  output int o
  ref Sub x
  region R1 { initial state A do o = x.get() go to B state B }
  region R2 { initial state C2 do x.set(5) go to D state D }
}
scchart Sub {
  schedule s
  int v = 0
  method void set(int a) schedule s 1 { for (int i = 0; i < 1; i++) { v = a } }
  method int get() schedule s 0 { int r = 0; for (int i = 0; i < 1; i++) { r = v } return r }
}
