// A contract method called in the copies of a for-region: two reads of the object at one priority, a circle.
scchart E18 {
  output int o[2]
  class C {
    schedule s
    int v = 0
    void set(int x) schedule s 1 { v = x }
    int get() schedule s 0 { return v }
  } c
  region R for i : 0 to 1 { initial state A do o[i] = c.get() go to B state B }
  region R2 { initial state C2 do c.set(5) go to D state D }
}
