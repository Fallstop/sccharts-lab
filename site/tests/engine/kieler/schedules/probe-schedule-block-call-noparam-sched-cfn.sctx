// A scheduled call, inside a code block, of a C function.
scchart G05 {
  output int o
  schedule s
  method void f() { for (int i = 0; i < 2; i++) { o = 1 } }
  region R1 { initial state A do { f() schedule s 1 } go to B state B }
  region R2 { initial state C do o = 2 schedule s 0 go to D state D }
}
