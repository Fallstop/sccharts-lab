// The same schedule used: it stays an ordinary schedule and orders the two writes (o += 2 at priority 0 before
// o = 1 at priority 1).
scchart Top {
  input int x
  output int o
  ref Box g(o)
}
scchart Box {
  output int o
  class A { class B { schedule s  int v = 0 } b } a
  region R1 { initial state P do o = 1 schedule a.b.s 1 go to P }
  region R2 { initial state Q do o += 2 schedule a.b.s 0 go to Q }
}
