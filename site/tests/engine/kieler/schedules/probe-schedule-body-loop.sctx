// A scheduled assignment inside a method with a loop (a C function), against a scheduled assignment.
scchart A01 {
  output int o
  schedule s
  method void setIt() { for (int i = 0; i < 2; i++) { o = 1 schedule s 1 } }
  region R1 { initial state A immediate do setIt() go to B state B }
  region R2 { initial state C immediate do o = 2 schedule s 0 go to D state D }
}
