// Two scheduled calls of two C functions: the schedule orders nothing between them.
scchart B33 {
  output int o
  output int p
  schedule s
  method void f() { for (int i = 0; i < 2; i++) { o = 1 } }
  method void g() { for (int i = 0; i < 2; i++) { p = o } }
  region R1 { initial state A do f() schedule s 1 go to B state B }
  region R2 { initial state C do g() schedule s 0 go to D state D }
}
