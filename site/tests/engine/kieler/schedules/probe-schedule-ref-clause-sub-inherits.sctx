// A clause naming, through the instance, a schedule that a chart used as a class inherits.
scchart Test {
  output int o
  ref Sub x
  region R { initial state A do o = 1 schedule x.s 1 go to B state B }
  region S { initial state C do o = 2 schedule x.s 0 go to D state D }
}
scchart Sub extends Base { int v }
scchart Base { schedule s }
