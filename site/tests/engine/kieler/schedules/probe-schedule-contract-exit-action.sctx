// Contract methods in an exit action and a concurrent transition.
scchart H10 {
  input bool a
  output int o
  class C {
    schedule s
    int v = 0
    void set(int x) schedule s 1 { v = x }
    int get() schedule s 0 { return v }
  } c
  region R1 { initial state A { exit do o = c.get() } if a go to B state B }
  region R2 { initial state C2 if a do c.set(5) go to D state D }
}
