// Two contracts that contradict each other.
scchart C04 {
  output int o
  class C {
    schedule s, t
    int v = 0
    void set(int x) schedule s 0 t 1 { v = x }
    int get() schedule s 1 t 0 { return v }
  } c
  region R1 { initial state A do o = c.get() go to B state B }
  region R2 { initial state C2 do c.set(5) go to D state D }
}
