// A contract method called in an initial value.
scchart C15 {
  output int o
  class C {
    schedule s
    int v = 3
    void set(int x) schedule s 0 { v = x }
    int get() schedule s 1 { return v }
  } c
  region R1 { initial state A go to B state B { int k = c.get() + 1 initial state X do o = k go to Y state Y } }
  region R2 { initial state C2 do c.set(5) go to D state D }
}
