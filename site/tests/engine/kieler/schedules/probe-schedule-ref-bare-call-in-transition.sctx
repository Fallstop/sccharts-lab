// A transition of a chart used as a class calls the chart's contract method by its name alone.
scchart Test {
  output int o
  ref Sub x
  initial state A do o = 1 go to B state B
}
scchart Sub {
  schedule s
  int v
  method void set() schedule s 0 { v = 1 }
  initial state P do set() go to Q state Q
}
