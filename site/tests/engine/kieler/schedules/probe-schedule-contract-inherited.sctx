// A class with contracts declared in a base chart, called in the extending chart.
scchart E15 extends Base {
  region R1 { initial state A do o = c.get() go to B state B }
  region R2 { initial state C2 do c.set(5) go to D state D }
}
scchart Base {
  output int o
  class C {
    schedule s
    int v = 0
    void set(int x) schedule s 1 { v = x }
    int get() schedule s 0 { return v }
  } c
}
