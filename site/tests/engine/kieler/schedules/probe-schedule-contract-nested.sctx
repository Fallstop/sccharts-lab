// A schedule in a class inside a class.
scchart C10 {
  output int o
  class Outer {
    class C {
      schedule s
      int v = 0
      void set(int x) schedule s 0 { v = x }
      int get() schedule s 1 { return v }
    } c
  } a
  region R1 { initial state A do o = a.c.get() go to B state B }
  region R2 { initial state C2 do a.c.set(5) go to D state D }
}
