// The test of V scheduled before the emission (priority 0 before 1).
scchart SchEmitReversed {
  input bool i
  output signal V
  output int n = 0
  schedule s
  region R1 {
    initial state A
    if i do V schedule s 1 go to A
  }
  region R2 {
    initial state C
    if V schedule s 0 do n++ go to C
  }
}
