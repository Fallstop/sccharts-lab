// Two instances of a chart used as a class have two schedules: the writes stay unordered.
scchart Test {
  output int o
  ref Sub x, y
  region R { initial state A do o = 1 schedule x.s 1 go to B state B }
  region S { initial state C do o = 2 schedule y.s 0 go to D state D }
}
scchart Sub { schedule s }
