// A chart used as a class with regions of its own and contracts called from the declaring chart.
scchart Test {
  output int o
  ref Sub x
  region R1 { initial state A do o = x.get() go to B state B }
  region R2 { initial state C do x.set(5) go to D state D }
}
scchart Sub {
  schedule s
  int v = 0
  int w = 0
  method void set(int a) schedule s 0 { v = a }
  method int get() schedule s 1 { return v }
  initial state P do w = 1 go to Q state Q
}
