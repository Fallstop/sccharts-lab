// At priority 1 too (the operators are both =, so the relative-write quirk does not apply).
scchart Legacy {
  output int x = 0
  output bool f = false
  schedule s
  region W {
    initial state A
    do x = x + 1 schedule s 1 go to A
  }
  region R {
    initial state B
    do x = x + 2 schedule s 1 go to B
  }
}
