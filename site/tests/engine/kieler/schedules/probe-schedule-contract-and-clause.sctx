// A contract and an explicit clause of another schedule on the calling effect.
scchart C03 {
  output int o
  schedule t
  class C {
    schedule s
    int v = 0
    void set(int x) schedule s 1 { v = x }
    int get() schedule s 0 { return v }
  } c
  region R1 { initial state A do o = c.get() schedule t 1 go to B state B }
  region R2 { initial state C2 do c.set(5) go to D state D }
  region R3 { initial state E do o = 9 schedule t 0 go to F state F }
}
