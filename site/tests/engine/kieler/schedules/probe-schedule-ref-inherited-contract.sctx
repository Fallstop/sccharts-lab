// A chart instance declared in a base chart: its contracts order the calls of the extending chart.
scchart Test extends Base {
  region R1 { initial state A do o = x.get() go to B state B }
  region R2 { initial state C do x.set(5) go to D state D }
}
scchart Base {
  output int o
  ref Sub x
}
scchart Sub {
  schedule s
  int v = 0
  method void set(int a) schedule s 0 { v = a }
  method int get() schedule s 1 { return v }
}
