// Contract methods in during actions of concurrent states.
scchart G08 {
  output int o
  class C {
    schedule s
    int v = 0
    void inc() schedule s 0 { v += 1 }
    int get() schedule s 1 { return v }
  } c
  region R1 { initial state A { during do o = c.get() } }
  region R2 { initial state C2 { during do c.inc() } }
}
