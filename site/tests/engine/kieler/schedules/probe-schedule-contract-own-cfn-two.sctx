// Two contract methods of one class that are C functions and touch the class's own member, concurrently.
scchart B45 {
  output int o
  class C {
    schedule s
    int v = 0
    void set() schedule s 0 { for (int i = 0; i < 1; i++) { v = 5 } }
    int get() schedule s 1 { int r = 0; for (int i = 0; i < 1; i++) { r = v } return r }
  } c
  region R1 { initial state A do o = c.get() go to B state B }
  region R2 { initial state C2 do c.set() go to D2 state D2 }
}
