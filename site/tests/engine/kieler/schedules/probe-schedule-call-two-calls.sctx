// Two scheduled calls of C functions that share no variable with each other.
scchart B11 {
  output int o
  output int p
  schedule s
  method void f() { for (int i = 0; i < 2; i++) { o = p + 1 } }
  method void g() { for (int i = 0; i < 2; i++) { p = 3 } }
  region R1 { initial state A immediate do f() schedule s 0 go to B state B }
  region R2 { initial state C immediate do g() schedule s 1 go to D state D }
}
