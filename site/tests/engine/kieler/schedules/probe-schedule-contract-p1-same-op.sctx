// Priority 1 with contract C functions and the same operator (=) on both sides.
scchart F20 {
  output int o
  class C {
    schedule {commuting, commuting} s
    int v = 0
    void set(int x) schedule s 1 { for (int i = 0; i < 1; i++) { v = x } }
    int get() schedule s 1 { int r = 0; for (int i = 0; i < 1; i++) { r = v } return r }
  } c
  region R1 { initial state A do o = c.get() go to B state B }
  region R2 { initial state C2 do c.set(5) go to D state D }
}
