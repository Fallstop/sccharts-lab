// A contract method in an argument of a short method, itself an argument of a C function that is an initial value.
scchart T {
  output int o
  class C { schedule s int get() schedule s 0 { return 3 } } c
  method int id(int x) { return x }
  method int wrap(int x) {
    for (int i = 0; i < 1; i++) { x += 1 }
    return x
  }
  initial state A do { int k = wrap(id(c.get())); o = k } go to B state B
}
