// A contract C function as the initial value of a local variable of a code block: accepted.
scchart H11 {
  output int o
  class C {
    schedule s
    int v = 0
    void set(int x) schedule s 1 { v = x }
    int get() schedule s 0 { int r = 0; for (int i = 0; i < 1; i++) { r = v } return r }
  } c
  region R1 { initial state A do { int k = c.get(); o = k } go to B state B }
  region R2 { initial state C2 do c.set(5) go to D state D }
}
