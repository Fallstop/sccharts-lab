// A chart with a class with contracts referenced by two states: each copy's class and schedule move into
// the referencing chart, and KIELER names the second copy's class after the first (C1, C2).
scchart E16b {
  output int o
  output int p
  region R1 { initial state S is Sub(o) }
  region R2 { initial state T is Sub(p) }
}
scchart Sub {
  output int r
  class C {
    schedule s
    int v = 0
    void set(int x) schedule s 1 { v = x }
    int get() schedule s 0 { return v }
  } c
  region R1 { initial state A do r = c.get() go to B state B }
  region R2 { initial state C2 do c.set(5) go to D state D }
}
