// A clause inside a class method's body naming the class's own schedule.
scchart C18 {
  output int o
  class C {
    schedule s
    int v = 0
    void set(int x) { v = x schedule s 0 }
    int get() { return v }
  } c
  region R1 { initial state A do o = c.get() go to B state B }
  region R2 { initial state C2 do c.set(5) go to D state D }
}
