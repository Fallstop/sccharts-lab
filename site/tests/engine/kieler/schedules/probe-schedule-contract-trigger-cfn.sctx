// A contract C function in a trigger with an operator.
scchart E08 {
  output int o
  class C {
    schedule s
    int v = 0
    void set(int x) schedule s 1 { for (int i = 0; i < 1; i++) { v = x } }
    int get() schedule s 0 { int r = 0; for (int i = 0; i < 1; i++) { r = v } return r }
  } c
  region R1 { initial state A if c.get() == 0 do o = 1 go to B state B }
  region R2 { initial state C2 do c.set(5) go to D state D }
}
