// An array as a value, targets: `m[0][0] = m[1] - m[0]`. KIELER runs it: m is [[4,7],[8,1]], [[2,7],[8,1]],
// [[2,7],[8,1]].
scchart Main { input bool b input int i int a[2] = {4,7} int c[2] = {4,7} int m[2][2] = {{4,7},{8,1}} float fa[2] bool ba[2] output int x output float f output bool y initial state A do m[0][0] = m[1] - m[0] go to A }
