// An array as a value, conditional: `x = (b ? a : fa) == a`. KIELER rejects it: pointer type mismatch in conditional
// expression [-Wincompatible-pointer-types].
scchart Main { input bool b input int i int a[2] = {4,7} int c[2] = {4,7} int m[2][2] = {{4,7},{8,1}} float fa[2] bool ba[2] output int x output float f output bool y initial state A do x = (b ? a : fa) == a go to A }
