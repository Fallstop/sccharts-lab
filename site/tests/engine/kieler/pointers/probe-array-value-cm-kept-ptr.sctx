// An array as a value, class methods: cm kept ptr. KIELER rejects it: assignment to ‘int’ from ‘int *’ makes integer
// from pointer without a cast [-Wint-conversion].
scchart Main { int a[2] class K { int p int q[2] int r[2] int g() { int s = 0 for (int j = 0; j < 2; j++) { s += q } return s } } k output int x initial state A do x = k.g() go to A }
