// An array as a value, bool and float arrays: `x = ba`. KIELER rejects it: assignment to ‘int’ from ‘char *’ makes
// integer from pointer without a cast [-Wint-conversion].
scchart Main { input bool b input int i int a[2] = {4,7} int c[2] = {4,7} int m[2][2] = {{4,7},{8,1}} float fa[2] bool ba[2] output int x output float f output bool y initial state A do x = ba go to A }
