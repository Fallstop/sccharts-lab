scchart Main { input bool b input int i int a[2] = {4,7} int c[2] = {4,7} int m[2][2] = {{4,7},{8,1}} float fa[2] bool ba[2] output int x output float f output bool y method void put(int p[2]) { p[1] = 9 } initial state A do put(c) go to A }
