// An array as a value, locals of inner states: loc two states. KIELER runs it: x is 0, 5, 5; a is [0,0], [7,0],
// [7,0].
scchart Main { int a[2] output int x region R1 { initial state A { int l[2] initial state I do x = l - a go to I } } region R2 { initial state B { int l[2] initial state I do a[0] = l - a go to I } } }
