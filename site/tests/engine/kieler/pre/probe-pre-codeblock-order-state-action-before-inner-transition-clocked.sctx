// In a superstate, the code block of an inner state's transition comes after the one of its own action: its
// pre(x, c) decides.
scchart Main {
  input int n
  input bool c
  output int o
  int x = 2
  int y
  initial state A {
    during do { y = pre(x) }
    initial state A1
    do x = n; { o = pre(x, c) + 1 } go to A1
  }
}
