// An input bound to 5, pre(i) in a C function: the memory of the copy's variable.
scchart Main {
  input int n
  output int o
  initial state A is C(5, o)
}

scchart C {
  input int i
  output int o
  method int last() { int t = 0; for (int j = 0; j < 2; j++) { t += pre(i) } return t }
  initial state A
  do o = last() go to A
}
