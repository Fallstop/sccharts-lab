// A class method with pre(x, c) declared before a chart method with pre(x): the chart method decides, no clock.
scchart Main {
  input int n
  input bool c
  output int o
  int x = 2
  class K { int f() { return pre(x, c) + 1 } } k
  method int last() { return pre(x) + 1 }
  initial state A
  do x = n; o = last() + 10 * k.f() go to A
}
