// A code block is declared after everything else, a region's declarations included: its pre(x) decides over the
// instance method's pre(i, cc).
scchart Main {
  input int n
  input bool c
  output int o
  output int p
  int x = 2
  region R1 {
    ref C g(x, c)
    initial state A
    do x = n; o = g.f(); { p = pre(x) + 1 } go to A
  }
}

scchart C {
  input int i
  input bool cc
  method int f() { return pre(i, cc) + 1 }
}
