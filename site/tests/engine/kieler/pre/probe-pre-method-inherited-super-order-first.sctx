// The base's first method is kept for a super call and stays at its place among the inherited declarations: the
// base's second method (pre(x)) comes later and decides.
scchart Main extends Base {
  override method int last() { return super.last() + 10 }
  initial state A
  do x = n; o = last(); y = other() go to A
}

scchart Base {
  input int n
  input bool c
  output int o
  int x = 2
  int y
  method int last() { return pre(x, c) + 1 }
  method int other() { return pre(x) + 2 }
}
