// A method with a loop (a C function) in a state inside a for-region, reading pre(x): every copy has its own.
scchart Main {
  input int n
  output int o[2]
  int x = 2
  region {
    initial state W
    do x = n go to W
  }
  region for i : 0 to 1 {
    initial state A {
      method int last() { int t = 0; for (int j = 0; j < 2; j++) { t += pre(x) } return t }
      initial state A1
      do o[i] = last() + i go to A1
    }
  }
}
