// return pre(K) of a generic parameter given 3, in a method nobody calls: no error, the chart runs.
scchart Main {
  input int n
  output int o
  initial state A is G<3>(n, o)
}

scchart G<K is int> {
  input int n
  output int o
  method int last() { return pre(K) }
  initial state A
  do o = n go to A
}
