// sum(pre(x) + 1) in a method, sum a C function: inside an operator the pre is replaced.
scchart Main {
  input int n
  output int o
  int x = 2
  method int sum(int v) { int t = 0; for (int j = 0; j < 2; j++) { t += v } return t }
  method int last() { int r; r = sum(pre(x) + 1); return r }
  initial state A
  do x = n; o = last() go to A
}
