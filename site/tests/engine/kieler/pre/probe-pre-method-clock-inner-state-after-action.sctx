// A method of an inner state comes after the chart's own actions: its pre(x, c) decides over the during
// action's pre(x).
scchart Main {
  input int n
  input bool c
  output int o
  int x = 2
  int y
  during do y = pre(x)
  initial state A {
    method int last() { return pre(x, c) + 1 }
    initial state B
    do x = n; o = last() go to B
  }
}
