// The code block of the chart's own action (_effect0) comes before the one of an inner state's transition
// (_effect1): the transition's pre(x) decides.
scchart Main {
  input int n
  input bool c
  output int o
  int x = 2
  int y
  during do { y = pre(x, c) }
  initial state A
  do x = n; { o = pre(x) + 1 } go to A
}
