// The inheriting chart's during action (pre(x)) comes after the base's method (pre(x, c)): no clock.
scchart Main extends Base {
  int y
  during do y = pre(x)
  initial state A
  do x = n; o = last() go to A
}

scchart Base {
  input int n
  input bool c
  output int o
  int x = 2
  method int last() { return pre(x, c) + 1 }
}
