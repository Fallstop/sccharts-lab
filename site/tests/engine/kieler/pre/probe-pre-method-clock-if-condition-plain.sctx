// An if's condition comes after its then branch: the condition's pre(x) decides over the body's pre(x, c), no
// clock.
scchart Main {
  input int n
  input bool c
  output int o
  int x = 2
  method int last() { if (pre(x) > 2) { return pre(x, c) + 1 } return 0 }
  initial state A
  do x = n; o = last() go to A
}
