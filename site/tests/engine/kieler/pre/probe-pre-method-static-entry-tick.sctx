// The same with a static variable of the superstate: neither the variable nor its memory starts again (o = 9 in
// tick 4).
scchart Main {
  input int n
  output int o
  output int p
  initial state A {
    static int s = 2
    method int last() { return pre(s) + 1 }
    entry do p = last()
    initial state B
    do s = n + 5; o = last() go to B
  }
  if n == 3 go to A
}
