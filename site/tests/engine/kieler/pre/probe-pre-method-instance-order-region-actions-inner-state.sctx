// ref C g(x, c) declared in a region that has an action: the state that wraps the region declares the class
// before the states inside it, so an inner state's method (pre(x)) decides.
scchart Main {
  input int n
  input bool c
  output int o
  int x = 2
  int y
  region R {
    ref C g(x, c)
    entry do o = 0
    initial state A {
      method int m() { return pre(x) + 1 }
      initial state A1
      do x = n; o = g.f(); y = m() go to A1
    }
  }
}

scchart C {
  input int i
  input bool cc
  method int f() { return pre(i, cc) + 1 }
}
