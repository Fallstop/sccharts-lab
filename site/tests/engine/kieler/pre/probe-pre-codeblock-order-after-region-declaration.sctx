// A region's variable with pre(x, c) in its initial value and a code block with pre(x): the region's
// declarations reach the state before the code blocks become methods, so the block comes later and decides, no
// clock.
scchart Main {
  input int n
  input bool c
  output int o
  output int p
  int x = 2
  region R {
    int y = pre(x, c) + 1
    initial state A
    do x = n; p = y; { o = pre(x) + 1 } go to A
  }
}
