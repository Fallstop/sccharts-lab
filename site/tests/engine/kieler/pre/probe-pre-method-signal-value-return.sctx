// return pre(val(S)): the pre is the whole return value.
scchart Main {
  input int n
  output int o
  signal int S
  method int last() { if (pre(S) == true) { return pre(val(S)) } return -1 }
  region {
    initial state A
    do o = last() go to A
  }
  region {
    initial state B
    if n == 2 do S(n) go to B
  }
}
