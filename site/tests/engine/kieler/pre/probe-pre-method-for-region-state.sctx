// A method of a state inside a for-region: every copy has its own, reading pre of the chart's x.
scchart Main {
  input int n
  output int o[2]
  int x = 2
  region {
    initial state W
    do x = n go to W
  }
  region for i : 0 to 1 {
    initial state A {
      method int last() { return pre(x) + 1 }
      initial state A1
      do o[i] = last() + i go to A1
    }
  }
}
