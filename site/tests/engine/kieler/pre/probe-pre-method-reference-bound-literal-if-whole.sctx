// An input bound to true, if (pre(i)) in a method: the Pre processor's error.
scchart Main {
  input int n
  output int o
  initial state A is C(true, o)
}

scchart C {
  input bool i
  output int o
  method int last() { if (pre(i)) { return 1 } return 2 }
  initial state A
  do o = last() go to A
}
