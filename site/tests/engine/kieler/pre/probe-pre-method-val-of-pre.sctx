// val(pre(S)) in a method that is called: left as it is, gcc does not know `val`.
scchart Main {
  input int n
  output int o
  signal int S
  method int last() { return val(pre(S)) + 1 }
  region {
    initial state A
    do o = last() go to A
  }
  region {
    initial state B
    if n > 1 do S(n) go to B
  }
}
