// A superstate with a variable, a method reading its pre (called) and a join: the superstate finishes although
// the memory's during action runs.
scchart Main {
  input int n
  output int o
  initial state A {
    int x = 2
    method int last() { return pre(x) + 1 }
    initial state A1
    do x = n; o = last() go to A2
    final state A2
  }
  join to C
  state C
  do o = 100 go to A
}
