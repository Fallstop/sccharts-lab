// ref C g(x, c) declared after a chart method with pre(x, c): the instance method's pre(i) decides, no clock.
scchart Main {
  input int n
  input bool c
  output int o
  int x = 2
  method int last() { return pre(x, c) + 1 }
  ref C g(x, c)
  initial state A
  do x = n; o = last() + 10 * g.f() go to A
}

scchart C {
  input int i
  input bool cc
  method int f() { return pre(i) + 1 }
}
