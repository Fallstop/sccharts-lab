// pre(x, q) with a parameter as the clock, but a later pre(x) makes the memory: the clock is dropped with its
// pre and the chart runs.
scchart Main {
  input int n
  output int o
  int x = 2
  int y
  method int last(bool q) { return pre(x, q) + 1 }
  initial state A
  do x = n; o = last(n > 2); y = pre(x) go to A
}
