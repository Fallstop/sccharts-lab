// The base's during action (pre(x, c)) comes after the declarations, the inheriting chart's method included:
// the action decides.
scchart Main extends Base {
  method int mine() { return pre(x) + 10 }
  initial state A
  do x = n; o = mine() go to A
}

scchart Base {
  input int n
  input bool c
  output int o
  int x = 2
  int y
  during do y = pre(x, c)
}
