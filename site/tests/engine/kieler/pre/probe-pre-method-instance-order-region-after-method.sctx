// A region's declarations go to the end of its state's: the instance method's pre(i, cc) comes after the
// chart's method (pre(x)) and decides.
scchart Main {
  input int n
  input bool c
  output int o
  output int p
  int x = 2
  method int m() { return pre(x) + 1 }
  region R1 {
    ref C g(x, c)
    initial state A
    do x = n; o = g.f(); p = m() go to A
  }
}

scchart C {
  input int i
  input bool cc
  method int f() { return pre(i, cc) + 1 }
}
