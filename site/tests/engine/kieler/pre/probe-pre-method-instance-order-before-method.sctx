// ref C g(x, c) declared before a chart method: KIELER's class takes the ref declaration's place, so the chart
// method's pre(x) comes later and decides.
scchart Main {
  input int n
  input bool c
  output int o
  int x = 2
  ref C g(x, c)
  method int last() { return pre(x) + 1 }
  initial state A
  do x = n; o = last() + 10 * g.f() go to A
}

scchart C {
  input int i
  input bool cc
  method int f() { return pre(i, cc) + 1 }
}
