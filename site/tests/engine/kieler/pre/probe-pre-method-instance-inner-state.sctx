// ref C g, a method of a state inside C reads pre of that state's variable: runs.
scchart Main {
  input int n
  output int o
  ref C g
  initial state A
  do g.x = n; o = g.y go to A
}

scchart C {
  int x = 2
  int y
  initial state B {
    int z
    method int last() { return pre(z) + 1 }
    initial state D
    do z = x; y = last() go to D
  }
}
