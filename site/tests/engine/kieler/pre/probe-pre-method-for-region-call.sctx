// A chart method with pre(x) called from every copy of a for-region.
scchart Main {
  input int n
  output int o[2]
  int x = 2
  method int last() { return pre(x) + 1 }
  region {
    initial state W
    do x = n go to W
  }
  region for i : 0 to 1 {
    initial state A
    do o[i] = last() + i go to A
  }
}
