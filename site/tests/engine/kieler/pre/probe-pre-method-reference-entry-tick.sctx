// A referenced chart with a variable, a method reading its pre and an entry action, left and entered again.
scchart Main {
  input int n
  output int o
  output int p
  initial state A is C(n, o, p)
  if n == 3 go to A
}

scchart C {
  input int n
  output int o
  output int p
  int x = 2
  method int last() { return pre(x) + 1 }
  entry do p = last()
  initial state B
  do x = n + 5; o = last() go to B
}
