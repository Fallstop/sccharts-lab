// The same with a variable of the chart: its memory is the chart's and goes on (o = 9 in tick 4).
scchart Main {
  input int n
  output int o
  output int p
  int x = 2
  initial state A {
    method int last() { return pre(x) + 1 }
    entry do p = last()
    initial state B
    do x = n + 5; o = last() go to B
  }
  if n == 3 go to A
}
