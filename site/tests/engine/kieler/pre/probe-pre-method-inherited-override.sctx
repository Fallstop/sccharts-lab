// An override replaces the base's method (and its pre(x, c)): the memory has no clock.
scchart Main extends Base {
  override method int last() { return pre(x) + 10 }
  initial state A
  do x = n; o = last() go to A
}

scchart Base {
  input int n
  input bool c
  output int o
  int x = 2
  method int last() { return pre(x, c) + 1 }
}
