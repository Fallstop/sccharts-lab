// a[pre(x, c)] = pre(x): the target's index comes before the assigned value, which decides.
scchart Main {
  input int n
  input bool c
  output int o
  int x = 2
  int a[5]
  method void put() { a[pre(x, c)] = pre(x) }
  initial state A
  do x = n; put(); o = a[2] + 10 * a[3] + 100 * a[4] go to A
}
