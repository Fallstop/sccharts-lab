// ref C g(x, c) in the first region, a variable with pre(x) in its initial value in the second: the regions'
// declarations keep their order in the state, the variable decides.
scchart Main {
  input int n
  input bool c
  output int o
  output int p
  int x = 2
  region R1 {
    ref C g(x, c)
    initial state A
    do x = n; o = g.f() go to A
  }
  region R2 {
    int y = pre(x) + 1
    initial state B
    do p = y go to B
  }
}

scchart C {
  input int i
  input bool cc
  method int f() { return pre(i, cc) + 1 }
}
