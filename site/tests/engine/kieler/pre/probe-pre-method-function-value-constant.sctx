// pre(K) of a constant in a method with a loop that is called: KIELER's Pre processor only looks at pres of
// variables and leaves pre(4), which gcc refuses in a C function as in the tick.
scchart Main {
  input int n
  output int o
  const int K = 4
  method int last() { int t = 0; for (int j = 0; j < 2; j++) { t += pre(K) } return t }
  initial state A
  do o = last() go to A
}
