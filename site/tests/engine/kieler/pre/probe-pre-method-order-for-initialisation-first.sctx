// A for loop's initialisation comes before its condition: the condition's pre(x) decides over the
// initialisation's pre(x, c).
scchart Main {
  input int n
  input bool c
  output int o
  int x = 2
  method int last() { int t = 0; int j; for (j = pre(x, c); j < pre(x) + 3; j++) { t += 1 } return t }
  initial state A
  do x = n; o = last() go to A
}
