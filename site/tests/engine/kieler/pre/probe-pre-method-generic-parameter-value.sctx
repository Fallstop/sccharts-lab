// pre(K) of a value parameter given 3, in a method that is called: pre(3), which gcc refuses.
scchart Main {
  input int n
  output int o
  initial state A is G<3>(n, o)
}

scchart G<K is int> {
  input int n
  output int o
  method int last() { return pre(K) + 1 }
  initial state A
  do o = last() go to A
}
