// ref C g(x, c) declared in a region, the state's during action with pre(x, c): the action decides, both are
// clocked.
scchart Main {
  input int n
  input bool c
  output int o
  int x = 2
  int y
  during do y = pre(x, c)
  region R {
    ref C g(x, c)
    initial state A
    do x = n; o = g.f() go to A
  }
}

scchart C {
  input int i
  input bool cc
  method int f() { return pre(i) + 1 }
}
