// A class method reads pre(t.w), a member of a struct inside the class: gcc looks for `t` in the chart's data.
scchart Main {
  input int n
  output int o
  int x = 2
  class K { struct T { int w = 1 } t int f() { return pre(t.w) + 1 } } k
  initial state A
  do x = n; k.t.w = n; o = k.f() go to A
}
