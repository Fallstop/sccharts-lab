// A chart used as a class (ref C g): its method reads pre(x) of the chart's own variable, a field of the class:
// gcc fails.
scchart Main {
  input int n
  output int o
  ref C g
  initial state A
  do g.x = n; o = g.last() go to A
}

scchart C {
  int x = 2
  method int last() { return pre(x) + 1 }
}
