// Code blocks on transitions in two regions: the second region's pre(x, c) decides.
scchart Main {
  input int n
  input bool c
  output int o
  int x = 2
  int y
  region R1 {
    initial state A
    do x = n; { o = pre(x) + 1 } go to A
  }
  region R2 {
    initial state B
    do { y = pre(x, c) + 1 } go to B
  }
}
