// A for loop's condition comes after its body: the condition's pre(x) decides over the body's pre(x, c).
scchart Main {
  input int n
  input bool c
  output int o
  int x = 2
  method int last() { int t = 0; for (int j = 0; j < pre(x); j++) { t += pre(x, c) } return t }
  initial state A
  do x = n; o = last() go to A
}
