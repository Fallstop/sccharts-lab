// @UnpackClass: the field is the chart's variable k_v by the time the Pre processor runs, so pre(v) in the
// class's method runs.
scchart Main {
  input int n
  output int o
  int x = 2
  @UnpackClass class K { int v = 3 int f() { return pre(v) + 1 } } k
  initial state A
  do x = n; k.v = n; o = k.f() go to A
}
