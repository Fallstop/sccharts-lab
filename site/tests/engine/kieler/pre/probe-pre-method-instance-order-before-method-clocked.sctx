// ref C g(x, c) declared before a chart method with pre(x, c): the chart method decides, both are clocked.
scchart Main {
  input int n
  input bool c
  output int o
  int x = 2
  ref C g(x, c)
  method int last() { return pre(x, c) + 1 }
  initial state A
  do x = n; o = last() + 10 * g.f() go to A
}

scchart C {
  input int i
  input bool cc
  method int f() { return pre(i) + 1 }
}
