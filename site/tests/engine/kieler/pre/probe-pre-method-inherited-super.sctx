// An override that calls super: the base's method stays, renamed, with its pre(x, c); the override's pre(x)
// comes later and decides.
scchart Main extends Base {
  override method int last() { return super.last() + pre(x) }
  initial state A
  do x = n; o = last() go to A
}

scchart Base {
  input int n
  input bool c
  output int o
  int x = 2
  method int last() { return pre(x, c) + 1 }
}
