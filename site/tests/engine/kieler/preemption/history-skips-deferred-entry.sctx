scchart HistoryDeferred {
  input bool A, P, R
  output int where = 0

  initial state M {
    initial state I {
      entry do where = 1
    }
    if A go to J deferred

    state J {
      entry do where = 2
    }
  }
  if P go to Paused

  state Paused {
    entry do where = 9
  }
  if R go to M history
}
