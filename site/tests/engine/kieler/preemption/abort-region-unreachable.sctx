// KIELER checks the order of abort regions on its SCG, which has no nodes for states that cannot be reached: R0s1
// (an abort region before the region KIELER adds for its weak abort) is never entered, so the chart is accepted.
scchart AbortRegionUnreachable {
  input bool a, b
  output int x = 0
  region R0 {
    initial state R0s0
    if a do x++ go to R0s2
    state R0s1 {
      region {
        initial state I
        if b go to I
      }
      abort region Watch {
        initial state W
        if b go to F
        final state F
      }
    }
    go to R0s2
    state R0s2
    if b go to R0s0
  }
}
