// As probe-abort-trigger-inside-weak-count with a strong abort: rejected too.
scchart W {
  input bool a, beat
  output signal expired
  initial state Running {
    region Watchdog {
      initial state Watching
        if beat go to Watching
        if 3 true do expired go to Expired
      state Expired
    }
    region Work {
      initial state Idle
        if beat go to Idle
    }
  }
  if expired abort to Safe
  state Safe
}
