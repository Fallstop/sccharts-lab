// A spread constant read by a method of a class inside the chart: KIELER copies it into that class as Cell1_k.
scchart Main { output int o ref Cell c[2]({3, 8}) initial state A do o = c[1].x go to A }
scchart Cell { input const int k int x class In { int get() { return k } } q region R { initial state B do x = q.get() go to B } }
