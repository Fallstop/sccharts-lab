// A method KIELER does not inline (it loops), inside an operator in the index of an assigned member: the method is
// removed as unused all the same.
scchart Main {
  output int o
  class K { int a[2] } k
  method int big() { int s = 0 for (int j = 0; j < 1; j++) { s += 1 } return s }
  initial state A do k.a[big() + 0] = 7; o = k.a[1] go to A
}
