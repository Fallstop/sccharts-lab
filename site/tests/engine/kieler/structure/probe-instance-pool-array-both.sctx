// An array of two instances of a chart with a C function nobody calls and a short method that is called.
scchart Main { output int o ref Cell c[2] initial state A do o = c[1].get() go to B state B }
scchart Cell { method int get() { return 3 } method int big() { int r = 0; for (int i = 0; i < 2; i++) { r += 1 } return r } region RC { initial state B } }
