// A method KIELER keeps as a function reads its class's members through its own self parameter: its v += 1 never meets c.v += 1 outside (accepted, no dependency).
scchart A {
  class Cell { int v = 0
    void big() { for (int j = 0; j < 2; j++) { v += 1; } } } c
  region R0 { initial state B do c.big() go to B }
  region R1 { initial state A do c.v += 1 go to A }
}
