// A constant bound to an input that the referenced chart writes: the input is the constant itself, and KIELER's
// Const processor refuses the assignment.
scchart K13 {
  const int K = 4
  output int p
  initial state S is K13S(K, p)
}
scchart K13S {
  input int x
  output int o = 0
  initial state A do o += x; x += 1 go to A
}
