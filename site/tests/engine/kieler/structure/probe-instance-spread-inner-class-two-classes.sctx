// A spread constant named in two classes inside the chart: a copy in each.
scchart Main { output int o ref Cell c[2]({3, 8}) initial state A do o = c[1].x go to A }
scchart Cell { input const int k int x class In { int get() { return k } } q class Two { int get() { return k + 1 } } t region R { initial state B do x = q.get() + t.get() go to B } }
