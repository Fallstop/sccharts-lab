// A spread constant named in a class inside a class of the chart: the copy is in the innermost class.
scchart Main { output int o ref Cell c[2]({3, 8}) initial state A do o = c[1].x go to A }
scchart Cell { input const int k int x class Out { class In { int get() { return k } } q } p region R { initial state B do x = p.q.get() go to B } }
