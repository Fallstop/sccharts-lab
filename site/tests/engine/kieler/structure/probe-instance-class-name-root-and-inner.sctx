// Two instances declared together at the root (Cell1) and one in an inner state (Cell2, at the root Cell21).
scchart Main { output int o, p ref Cell c, d region R { initial state S { ref Cell e dataflow { o = e.get() + c.get() p = d.get() } } } }
scchart Cell { int v = 3 method int get() { return v } }
