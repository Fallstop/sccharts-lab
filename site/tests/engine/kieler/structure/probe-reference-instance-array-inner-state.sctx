// An array of chart instances declared in an inner state, with an entry action: reset when the state is entered
// again.
scchart M07 {
  output int p
  initial state W {
    ref M07C g[2]
    initial state A do g[1].n += 1; p = g[0].n + 10 * g[1].n go to A
  }
  if p > 60 go to W
}
scchart M07C {
  int n = 0
  entry do n = 5
}
