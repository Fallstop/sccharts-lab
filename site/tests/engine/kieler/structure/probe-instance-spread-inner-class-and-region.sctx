// A spread constant named by two methods of a class inside the chart and by a region: one copy, and the region has the value.
scchart Main { output int o ref Cell c[2]({3, 8}) initial state A do o = c[1].x go to A }
scchart Cell { input const int k int x class In { int get() { return k } int twice() { return k * 2 } } q region R { initial state B do x = q.get() + q.twice() + k go to B } }
