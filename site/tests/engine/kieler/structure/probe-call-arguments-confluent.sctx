// KIELER compares two calls of a model's method by the method and its instance, not by the arguments: o = c.add2(1) and o = c.add2(2) count as the same value (accepted; the later region wins).
scchart A {
  output int o
  class C { int k = 3
    int add2(int a) { int r = 0
      for (int j = 0; j < 1; j++) { r = k + a; }
      return r } } c
  region R0 { initial state A do o = c.add2(1) go to A }
  region R1 { initial state B do o = c.add2(2) go to B }
}
