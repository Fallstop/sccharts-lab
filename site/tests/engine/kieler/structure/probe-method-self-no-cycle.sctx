// o = c.get() reads v inside a kept method and c.v = o + 1 writes it outside: no dependency between them, so no cycle.
scchart A {
  output int o
  class Cell { int v = 0
    void set7() { for (int j = 0; j < 1; j++) { v = 7; } }
    void set8() { for (int j = 0; j < 1; j++) { v = 8; } }
    int get() { int r = 0; for (int j = 0; j < 1; j++) { r = v; } return r } } c, d
  region R0 { initial state A do o = c.get() go to A }
  region R1 { initial state B do d.set7() go to B }
  region R2 { initial state C do c.v = o + 1 go to C }
}
