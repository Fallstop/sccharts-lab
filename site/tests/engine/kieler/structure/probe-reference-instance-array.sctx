// ref C g[2]: an array of chart instances used as objects (g[0].inc()); the pool has an array of objects.
scchart G05 {
  output int p
  ref G05C g[2]
  initial state A do g[0].inc(); g[1].inc(); g[1].inc(); p = g[0].n + 10 * g[1].n go to A
}
scchart G05C {
  int n = 0
  method void inc() { n += 1 }
}
