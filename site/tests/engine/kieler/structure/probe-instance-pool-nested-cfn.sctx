// An instance inside an instance whose method is called through the outer one: an empty object inside, whether KIELER copies
// the method into place or keeps it.
scchart Main { output int o ref Mid m initial state A do o = m.run() go to B state B }
scchart Mid { int w = 5 ref Cell c method int run() { return c.big() } }
scchart Cell { method int big() { int r = 0; for (int i = 0; i < 2; i++) { r += 1 } return r } }
