// Control: two declarations. Only the instance used in the dataflow region keeps its ports; the other is bound by name.
scchart Main { int a = 9 output int o, p ref Cell c ref Cell d dataflow { o = c.get() } region R { initial state A immediate do p = d.get() go to B state B } }
scchart Cell { input int a = 3 method int get() { return a } }
