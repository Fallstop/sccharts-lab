// region is super.R with two instances declared together: a.v and b.v stay apart.
scchart T extends Base {
  override region R {
    initial state W { region is super.R }
  }
}
scchart Base {
  class C { int v = 0 } a, b
  output int o
  region R {
    initial state I
    do a.v += 1; b.v += 2; o = a.v*10+b.v go to I
  }
}
