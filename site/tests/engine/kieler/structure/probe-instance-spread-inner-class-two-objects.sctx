// A spread constant named in a class inside the chart that has two objects: KIELER only copies it into a class with one.
scchart Main { output int o ref Cell c[2]({3, 8}) initial state A do o = c[1].x go to A }
scchart Cell { input const int k int x class In { int get() { return k } } q, r region R { initial state B do x = q.get() + r.get() go to B } }
