// Two kept methods of one instance both write v: different selfs, accepted; the later region's write wins.
scchart A {
  class Cell { int v = 0
    void set7() { for (int j = 0; j < 1; j++) { v = 7; } }
    void set8() { for (int j = 0; j < 1; j++) { v = 8; } }
    int get() { int r = 0; for (int j = 0; j < 1; j++) { r = v; } return r } } c, d
  region R0 { initial state A do c.set7() go to A }
  region R1 { initial state B do c.set8() go to B }
}
