// An array of instances inside an instance whose chart has a C function nobody calls: an empty object inside.
scchart Main { output int o ref Mid m initial state A do o = 1 go to B state B }
scchart Mid { int w = 5 ref Cell c[2] region RM { initial state B } }
scchart Cell { method int big() { int r = 0; for (int i = 0; i < 2; i++) { r += 1 } return r } region RC { initial state B } }
