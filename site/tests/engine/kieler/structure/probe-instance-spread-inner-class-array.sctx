// A spread constant named in a class inside the chart that has an array of objects.
scchart Main { output int o ref Cell c[2]({3, 8}) initial state A do o = c[1].x go to A }
scchart Cell { input const int k int x class In { int get() { return k } } q[2] region R { initial state B do x = q[1].get() go to B } }
