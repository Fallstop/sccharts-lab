// An array of instances inside an instance, their method called through the outer one: empty objects inside.
scchart Main { output int o ref Mid m initial state A do o = m.run() go to B state B }
scchart Mid { int w = 5 ref Cell c[2] method int run() { return c[1].get() } }
scchart Cell { method int get() { return 3 } }
