// An instance without fields whose method with a loop is never called: no object in the pool.
scchart Top {
  output int o
  ref Box b
  initial state A do o = b.two() go to A
}
scchart Box {
  method int read() { int r = 0; for (int i = 0; i < 2; i++) { r += 1 } return r }
  method int two() { return 2 }
}
