// An instance inside an instance (with a field) whose chart has a short method nobody calls: an empty object inside the outer one.
scchart Main { output int o ref Mid m initial state A do o = 1 go to B state B }
scchart Mid { int w = 5 ref Cell c region RM { initial state B } }
scchart Cell { method int get() { return 3 } region RC { initial state B } }
