// An array of chart instances with a region: every element runs its own copy.
scchart M01 {
  output int p
  ref M01C g[2]
  initial state A do g[1].inc(); p = g[0].n + 10 * g[1].n go to A
}
scchart M01C {
  int n = 0
  method void inc() { n += 5 }
  region R { initial state S do n += 1 go to S }
}
