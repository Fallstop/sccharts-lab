// Declared together, one used in the dataflow region: the other's input is a field a transition can write.
scchart Main { int a = 9 output int o, p ref Cell c, d dataflow { o = c.get() } region R { initial state A do d.a = 5 go to B state B do p = d.get() go to A } }
scchart Cell { input int a = 3 method int get() { return a } }
