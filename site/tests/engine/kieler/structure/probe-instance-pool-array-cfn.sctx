// An array of two instances of a chart with a method that stays a C function and is called.
scchart Main { output int o ref Cell c[2] initial state A do o = c[1].big() go to B state B }
scchart Cell { method int big() { int r = 0; for (int i = 0; i < 2; i++) { r += 1 } return r } region RC { initial state B } }
