// The base method kept for super is a C function (a loop in it) and reads the bound input.
scchart Main { input int m output int o initial state A is C(m, o) }
scchart C extends Base { override method int last() { return super.last() + 10 } initial state A do o = last() go to A }
scchart Base { input int n output int o method int last() { int t = 0; for (int j = 0; j < 2; j++) { t += n } return t } }
