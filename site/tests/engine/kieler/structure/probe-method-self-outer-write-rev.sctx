// As probe-method-self-outer-write with the regions swapped.
scchart A {
  class Cell { int v = 0
    void set7() { for (int j = 0; j < 1; j++) { v = 7; } }
    void set8() { for (int j = 0; j < 1; j++) { v = 8; } }
    int get() { int r = 0; for (int j = 0; j < 1; j++) { r = v; } return r } } c, d
  region R0 { initial state B do c.v = 8 go to B }
  region R1 { initial state A do c.set7() go to A }
}
