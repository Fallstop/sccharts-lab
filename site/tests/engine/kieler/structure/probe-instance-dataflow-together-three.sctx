// Three instances of one declaration, one used in a dataflow region that calls a method: all three keep their ports.
scchart Main { int a = 9 output int o, p, q ref Cell c, d, e dataflow { o = c.get() } region R { initial state A immediate do p = d.get(); q = e.get() go to B state B } }
scchart Cell { input int a = 3 method int get() { return a } }
