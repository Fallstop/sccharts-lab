// A kept method of a nested class called on two nested instances: a write-write conflict.
scchart A {
  class Box { class In { int v = 0
      void set7() { for (int j = 0; j < 1; j++) { v = 7; } } } in, in2 } box
  region R0 { initial state A do box.in.set7() go to A }
  region R1 { initial state B do box.in2.set7() go to B }
}
