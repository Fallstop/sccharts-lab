// A fieldless instance with an argument, whose C function reads the bound input: an empty object.
scchart Main { input int i output int o ref Cell c(i) initial state A do o = c.big() go to B state B }
scchart Cell { input int q method int big() { int r = 0; r = q; for (int j = 0; j < 2; j++) { r += 1 } return r } }
