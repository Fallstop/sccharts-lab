// A recursive method that is never called: KIELER accepts the chart (its dependency analysis only follows calls).
scchart ProbeRecursiveUncalled {
  input int n
  output int f = 0

  method int fact(int k) {
    if (k <= 1) {
      return 1
    }
    return k * fact(k - 1)
  }

  initial state A
    do f = n + 1 go to A
}
