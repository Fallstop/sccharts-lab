// An OO instance keeps the initial values of its inputs and outputs (input int a = 4, b = 5; output int s = 9, t =
// 3): they are ordinary members.
scchart DfInstanceInitialValues {
  input int x
  output int o, m
  ref Ini g
  method int twice(int v) { return v * 2 }
  dataflow {
    g.a = twice(x)
    o = g.s
  }
}
scchart Ini {
  input int a = 4, b = 5
  output int s = 9, t = 3
  dataflow { s = a + 10 * b }
}
