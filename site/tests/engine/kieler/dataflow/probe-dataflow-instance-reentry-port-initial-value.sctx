// The same for an OO instance's output with an initial value (output int s = 7): 7 again at every entry.
scchart DfInstanceReentryPortInitialValue {
  input int x
  input bool r
  output int o, m
  method int twice(int v) { return v * 2 }
  initial state S {
    ref Cnt19 g
    dataflow {
      g.a = twice(x)
      o = g.s
    }
  } if r go to T
  state T do m += 1 go to S
}
scchart Cnt19 {
  input int a
  output int s = 7
  int n
  initial state A do n += 1; s = a + 100 * n go to A
}
