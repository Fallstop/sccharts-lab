// A method of a chart instance that calls a method of an instance declared inside that chart is kept as a function:
// its read of the inner field is the method's own self, not ordered after the concurrent write.
scchart DfInstanceNestedMethodRead {
  input int x
  output int o
  ref Mid g
  region R { initial state A do o = g.get() + x go to A }
}
scchart Mid {
  ref Cnt t
  method int get() { return t.get() }
  region T { initial state A do t.add(2) go to A }
}
scchart Cnt {
  int v = 0
  method void add(int k) { v += k }
  method int get() { return v }
}
