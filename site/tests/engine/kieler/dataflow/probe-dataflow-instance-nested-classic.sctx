// An OO instance of a chart that wires an instance itself in a classic dataflow region: that inner instance's hidden
// variables are members of the outer object (g: {__df_t_a, ...}).
scchart DfInstanceNestedClassic {
  input int x
  output int o, m
  ref Outer g
  method int twice(int v) { return v * 2 }
  dataflow {
    g.a = twice(x)
    o = g.s
  }
}
scchart Outer {
  input int a
  output int s
  ref Two t
  dataflow { t.a = a  t.b = 3  s = t.s }
}
scchart Two {
  input int a, b
  output int s
  dataflow { s = a + b + 1 }
}
