// An instance named only inside indices on the right (arr[ix.n] + arr[ix.n - 1]) is still made an instance of the
// region.
scchart Main {
  output int o
  int arr[2] = {5, 6}
  ref Index ix
  dataflow { o = arr[ix.n] + arr[ix.n - 1] }
}
scchart Cell { input int a[2] output int b[2] initial state A do b[0] = a[0] + 10; b[1] = a[1] + 20 go to A }
scchart Index { output int n = 1 }
