// k.add(1); o1 = k.get() + n; k.add(1); o2 = k.get(): the first call is unordered (it runs before the reads as any
// write), the assignment's ; orders the second call after it.
scchart DfCallSemicolonBetween {
  input bool a
  input int n
  output int o1, o2
  ref K k
  dataflow {
    k.add(1);
    o1 = k.get() + n;
    k.add(1);
    o2 = k.get()
  }
}
scchart K {
  int v = 0
  method void add(int j) { v += j }
  method int get() { return v }
}
