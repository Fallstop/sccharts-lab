// An instance declared in the chart and wired in a dataflow region of an inner state: the validator only looks at the
// dataflow regions of the declaring state, the bindings are missing. Rejected.
scchart DfInstanceDeclaredOutside {
  input int x
  input bool r
  output int o, m
  ref Cnt2 g
  method int twice(int v) { return v * 2 }
  initial state S {
    dataflow {
      g.a = twice(x)
      o = g.s
    }
  } if r go to T
  state T do m += 1 go to S
}
scchart Cnt2 {
  input int a
  output int s
  int n = 0
  initial state A do n += 1; s = a + 100 * n go to A
}
