// arr[arr[n % 2]] > 0 && f: the first pass takes the inner index, the second the outer one.
scchart F {
  input int n
  output int o
  output bool f
  int arr[2]
  class Cell {
    int v = 0
  } cells[2], c
  struct Row { int arr[2] } rows[2]
  region R1 {
    initial state A
    if arr[arr[n % 2]] > 0 && f go to B
    state B
  }
}
