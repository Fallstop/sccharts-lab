// arr[n % 2] + arr[n % 2] > 0 && f: two addresses added, which gcc rejects.
scchart F {
  input int n
  output int o
  output bool f
  int arr[2]
  class Cell {
    int v = 0
  } cells[2], c
  struct Row { int arr[2] } rows[2]
  region R1 {
    initial state A
    if arr[n % 2] + arr[n % 2] > 0 && f go to B
    state B
  }
}
