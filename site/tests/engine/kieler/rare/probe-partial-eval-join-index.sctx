// An index that reads a member of an element with a variable index, in a join's trigger.
scchart F {
  input int n
  output int o
  int arr[2]
  class Cell {
    int v = 0
  } cells[2]
  region R1 {
    initial state A {
      region {
        initial state I
        go to D
        final state D
      }
    }
    if arr[cells[n % 2].v] == 0 join to B
    state B
  }
}
