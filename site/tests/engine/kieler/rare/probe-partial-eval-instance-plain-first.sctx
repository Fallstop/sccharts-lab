// The plain variable first: KIELER gives up before the element, the index stays.
scchart F {
  input int n
  output int o
  output bool f
  int arr[2]
  class Cell {
    int v = 0
  } cells[2], c
  struct Row { int arr[2] } rows[2]
  region R1 {
    initial state A
    if f && cells[n % 2].v > 0 go to B
    state B
  }
}
