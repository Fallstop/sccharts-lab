// A join's trigger gets the termination flag appended, a plain variable: the element of an array of instances before it loses its index (found by the nested fuzz profile, seed 3).
scchart F {
  input int n
  output int o
  class Cell {
    int v = 0
    int sum(int a) { return v + a }
  } cells[2], c
  struct Row { int arr[2] } rows[2]
  region R1 {
    initial state A {
      region {
        initial state I
      }
    }
    if cells[n % 2].v > 0 join to A
    state B
  }
}
