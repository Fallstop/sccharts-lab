// An element of an array of instances with a variable index, then a plain variable: gcc rejects the member of the array.
scchart F {
  input int n
  output int o
  output bool f
  int arr[2]
  class Cell {
    int v = 0
  } cells[2], c
  struct Row { int arr[2] } rows[2]
  region R1 {
    initial state A
    if cells[n % 2].v > 0 && n > 0 go to B
    state B
  }
}
