// The same with a method of the element.
scchart F {
  input int n
  output int o
  class Cell {
    int v = 0
    int sum(int a) { return v + a }
  } cells[2], c
  struct Row { int arr[2] } rows[2]
  region R1 {
    initial state A {
      region {
        initial state I
      }
    }
    if cells[n % 2].sum(1) > 2 join to A
    state B
  }
}
