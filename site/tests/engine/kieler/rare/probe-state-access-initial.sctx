scchart StateAccessInitial {
  input bool step
  output int a = 0
  output int b = 0
  method int idle() {
    if (state(Main.Idle)) {
      return 1
    }
    return 0
  }
  region Main {
    initial state Idle
      if step go to Running
    state Running
      if step go to Idle
  }
  region Count {
    initial state C
      immediate do a = a + idle(); b = b + 1 go to D
    state D
      if true do a = a + idle() go to D
  }
}
