// 30 nodes: KIELER compiles the block as a C function, whose structured code drops the backward jump (the rest only runs when it is not taken).
scchart GotoBack30 {
  input bool start
  output int n = 0, m = 0
  initial state S
    if start do {
      again:
      n++;
      m++;
      m++;
      m++;
      m++;
      m++;
      m++;
      m++;
      m++;
      m++;
      m++;
      m++;
      m++;
      m++;
      m++;
      m++;
      m++;
      m++;
      m++;
      m++;
      m++;
      m++;
      m++;
      m++;
      m++;
      m++;
      m++;
      if (n % 3 != 0) {
        goto again
      }
    } go to S
}
