scchart JoinAllAtOnce {
  input bool a, b, c
  output bool done

  initial state S {
    region RA {
      initial state W
      if a go to F
      final state F
      if c go to W
    }
    region RB {
      initial state W
      if b go to F
      final state F
    }
  }
  join to D

  state D {
    entry do done = true
  }
}
