// The chart of 93 without the reset loop: the count delay "if 4 true" on WaitAB fires in its 4th tick after
// entry (tick 5).
scchart P94CountNoReset {
  input signal A, B, R
  output signal O, late
  initial state ABO {
    initial state WaitAB {
      region HandleA {
        initial state WaitA
        if A go to DoneA
        final state DoneA
      }
      region HandleB {
        initial state WaitB
        if B go to DoneB
        final state DoneB
      }
    }
    if 4 true do late go to Done
    do O join to Done
    state Done
  }
}
