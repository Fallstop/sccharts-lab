// A count delay on a transition inside a state that has a self-loop (here the reset "if R abort to ABO") is
// rejected: the count's counter is a local of ABO, and KIELER cannot schedule its reset, increment and pre
// register in the tick ABO is left and entered again. Without the reset loop the same chart runs (94).
scchart P93CountUnderReset {
  input signal A, B, R
  output signal O, late
  initial state ABO {
    initial state WaitAB {
      region HandleA {
        initial state WaitA
        if A go to DoneA
        final state DoneA
      }
      region HandleB {
        initial state WaitB
        if B go to DoneB
        final state DoneB
      }
    }
    if 4 true do late go to Done
    do O join to Done
    state Done
  }
  if R abort to ABO
}
