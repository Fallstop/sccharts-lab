scchart PrinterClash {
  input bool reqA, reqB   // computer A or B wants to print
  output int user = 0     // who is printing: 0 nobody, 1 A, 2 B

  region ComputerA {
    initial state Idle
      if reqA do user = 1 go to Printing

    state Printing
      if !reqA do user = 0 go to Idle
  }

  region ComputerB {
    initial state Idle
      if reqB do user = 2 go to Printing

    state Printing
      if !reqB do user = 0 go to Idle
  }
}
