scchart ABROResetInside {
  input signal A, B, R
  output signal O

  initial state WaitAB {
    region HandleA {
      initial state WaitA
        if A go to DoneA
      final state DoneA
    }
    region HandleB {
      initial state WaitB
        if B go to DoneB
      final state DoneB
    }
  }
  if R abort to WaitAB
  do O join to Done

  state Done
}
