scchart ABROImmediate {
  input signal A, B, R
  output signal O

  initial state ABO {
    initial state WaitAB {
      region HandleA {
        initial state WaitA
          immediate if A go to DoneA
        final state DoneA
      }
      region HandleB {
        initial state WaitB
          immediate if B go to DoneB
        final state DoneB
      }
    }
    do O join to Done

    state Done
  }
  if R abort to ABO
}
