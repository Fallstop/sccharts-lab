scchart ABORepeat {
  input signal A, B
  output signal O

  initial state WaitAB {
    region HandleA {
      initial state WaitA
        if A go to DoneA
      final state DoneA
    }
    region HandleB {
      initial state WaitB
        if B go to DoneB
      final state DoneB
    }
  }
  do O join to WaitAB
}
