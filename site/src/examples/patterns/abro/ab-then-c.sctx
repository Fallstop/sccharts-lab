scchart ABThenC {
  input signal A, B, C, R
  output signal O

  initial state ABO {
    initial state WaitAB {
      region HandleA {
        initial state WaitA
          if A go to DoneA
        final state DoneA
      }
      region HandleB {
        initial state WaitB
          if B go to DoneB
        final state DoneB
      }
    }
    join to WaitC

    state WaitC
      immediate if C do O go to Done

    state Done
  }
  if R abort to ABO
}
