scchart WatchdogInsideCounter {
  input bool beat, demand
  output bool motor, alarm
  output int starts = 0, quiet = 0
  signal expired

  initial state Running {
    exit do motor = false

    region Watchdog {
      initial state Watching
        if beat do quiet = 0 go to Watching
        if quiet == 2 do quiet++; expired go to Expired
        do quiet++ go to Watching

      state Expired
    }

    region Work {
      initial state Stopped
        if demand do motor = true; starts++ go to Started

      state Started
        if !demand do motor = false go to Stopped
    }
  }
  if expired abort to Safe

  state Safe {
    entry do alarm = true
  }
}
