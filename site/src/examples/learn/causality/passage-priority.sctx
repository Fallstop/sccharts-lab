scchart PassagePriority {
  input bool aWants, bWants
  output bool aGoes = false, bGoes = false

  region RobotA {
    initial state Waiting
      if aWants do aGoes = true go to Passing
    state Passing
      do aGoes = false go to Through
    state Through
  }

  region RobotB {
    initial state Waiting
      if bWants && !aGoes do bGoes = true go to Passing
    state Passing
      do bGoes = false go to Through
    state Through
  }
}
