scchart Regions {
  input bool A, B
  output bool O

  initial state WaitAB {
    region HandleA "Wait for A" {
      initial state WaitA
        if A go to DoneA
      final state DoneA
    }
    region HandleB {
      initial state WaitB
        if B go to DoneB
      final state DoneB
    }
  }
  do O = true join to Done

  final state Done
}
