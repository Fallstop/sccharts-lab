scchart PushSwitchFirst {
  input bool press
  output bool lit = false

  initial state Off
    if press do lit = true go to On

  state On
    if press do lit = false go to Off
}

scchart PanelSecond {
  input bool left, right
  output bool leftLamp = false, rightLamp = false

  region {
    initial state Left is PushSwitchFirst(left to press, leftLamp to lit)
  }
  region {
    initial state Right is PushSwitchFirst(right to press, rightLamp to lit)
  }
}
