scchart Above {
  input int samples[4]
  input int threshold
  output int high = 0

  method int countAbove(int t) {
    int n = 0
    for (int i = 0; i < 4; i++) {
      if (samples[i] > t) {
        n++
      }
    }
    return n
  }

  initial state Measure
    do high = countAbove(threshold) go to Measure
}
