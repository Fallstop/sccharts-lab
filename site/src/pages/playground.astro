---
/**
 * /playground: SCCharts Lab's in-browser IDE for SCCharts, a full-window app. An app bar (the mark, the guide's
 * menu, the project, Examples, Copy link, search, help), then the workspace: the files sidebar | the editor (with
 * tabs) | the diagram, and the bottom panel with its tabs (the simulation, problems, console). On phones one pane at
 * a time, with tabs. The client code (src/components/playground/boot.ts, then app.ts) loads after the page has
 * painted: until then (and without JavaScript) the page shows the starter chart's source, highlighted with the
 * editor's own tokenizer, its diagram (rendered at build time) and the example list as links.
 *
 * ?example=<id> opens an example (TryIt links), #code=<lz-string> a shared chart, #project= a shared project;
 * otherwise the reader's last project (IndexedDB) or the default chart. &solution=<id> (an exercise's TryIt link)
 * offers "Compare with the model solution" and shows the exercise's task (the TryIt's title and text, from the MDX).
 *
 * The page keeps Starlight's head and sidebar (the guide's menu, opened by the app bar's Guide button, a popover);
 * Starlight's header is hidden, and its search moves into the app bar (playground.css, the inline script below).
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import { getCollection, render } from 'astro:content'
import { exampleIds, loadExample, type Scenario } from '../components/frame/examples'
import LogoMark from '../components/overrides/LogoMark.astro'
import { buildCatalogue, allItems } from '../components/playground/catalogue'
import { findExercises } from '../components/playground/exercises'
import { SHOWCASE, showcaseSources } from '../components/playground/showcase'
import { highlightLines } from '../components/playground/static-highlight'
import { codeColourCss } from '../components/playground/code-colours'
import { pgIcons } from '../components/playground/icons'
import { exampleFile } from '../components/playground/project'
import ExamplesMenu from '../components/playground/page/ExamplesMenu.astro'
import HelpMenu from '../components/playground/page/HelpMenu.astro'
import ProjectMenu from '../components/playground/page/ProjectMenu.astro'
import TaskBanner from '../components/playground/page/TaskBanner.astro'
import BottomPanel from '../components/playground/page/BottomPanel.astro'
import { embedIcon } from '../components/embed/embed-button'
import { compile } from '@sccharts-lab/engine'
import { chartToSvg } from '@sccharts-lab/diagram'
import '@sccharts-lab/diagram/diagram.css'
import '../components/playground/styles/page.css'

const DEFAULT_ID = 'showcase/abro'

// The example menu: every example of the guide (not the widget tests under design/), grouped by page.
const docs = await getCollection('docs')
const ids = exampleIds().filter((id) => !id.startsWith('design/'))
const sources: Record<string, string> = {}
const rejected = new Set<string>()
for (const id of ids) {
	const ex = loadExample(id, '/playground')
	sources[id] = ex.source
	if (ex.scenario?.expect === 'error') rejected.add(id)
}
const groups = buildCatalogue(
	sources,
	docs.map((d) => ({ id: d.id, title: d.data.title, order: d.data.sidebar?.order, body: d.body })),
	SHOWCASE,
	rejected,
)
const items = allItems(groups)
// The exercises (every <TryIt> of the guide, with its page's section), for the task banner of a TryIt link.
const exercises = findExercises(
	await Promise.all(
		docs.filter((d) => d.body?.includes('<TryIt')).map(async (d) => ({ id: d.id, title: d.data.title, body: d.body, headings: (await render(d)).headings })),
	),
)
// Whether "Compare with the model solution" works (exercise.ts checks the same): a test run recorded with KIELER's
// netlist compiler. The page then shows the button from the start.
for (const e of exercises) {
	if (!e.solution) continue
	const solution = loadExample(e.solution, '/playground')
	const scenario = solution.scenario as (Scenario & { system?: string }) | undefined
	const recording = solution.oracle as (typeof solution.oracle & { interface?: unknown }) | undefined
	e.compare = !!(scenario && scenario.expect !== 'error' && scenario.ticks?.length && (!scenario.system || scenario.system === 'netlist') && recording?.ok && recording.ticks?.length && recording.interface)
}
const defaultTitle = items.find((i) => i.id === DEFAULT_ID)?.title ?? 'ABRO'
const defaultFile = exampleFile(DEFAULT_ID)

const defaultSource = showcaseSources()[DEFAULT_ID]
const lines = highlightLines(defaultSource)
const compiled = compile(defaultSource)
const diagramSvg = compiled.chart ? await chartToSvg(compiled.chart, { program: compiled.program, fit: 'natural', idPrefix: 'pg0' }) : ''
const inputs = compiled.interface.filter((v) => v.input && !v.const).map((v) => ({ name: v.name, direction: 'input' as const, type: v.signal && !v.valued ? 'signal' : v.type }))

const json = (v: unknown) => JSON.stringify(v).replace(/</g, '\\u003c')
const data = json({ defaultId: DEFAULT_ID, defaultSource, defaultFile })
---

<StarlightPage
	frontmatter={{
		title: 'Playground',
		description: 'Write SCCharts, see their diagrams and run them tick by tick in your browser.',
		template: 'splash',
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	hasSidebar
>
	<Fragment set:html={`<style>${codeColourCss()}</style>`} />
	<div class="sc-pg not-content" data-sc-playground data-tab="code" data-files="closed" data-pagefind-ignore="all">
		<script is:inline>document.currentScript.parentElement.setAttribute('data-pg-js', '')</script>
		<script type="application/json" data-pg-data set:html={data} />

		<header class="sc-pg-appbar">
			<a class="sc-pg-appbar__home" href="/" title="SCCharts Lab: the guide's home page">
				<LogoMark size={26} />
				<span class="sc-pg-appbar__brand">SCCharts Lab</span>
			</a>
			<button type="button" class="sc-pg-appbar__btn" popovertarget="starlight__sidebar" data-pg-guide title="The guide's pages">
				<Fragment set:html={pgIcons.menu} /><span class="sc-pg-appbar__label">Guide</span>
			</button>
			<span class="sc-pg-appbar__rule" aria-hidden="true"></span>
			<ProjectMenu name={defaultTitle} />
			<a class="sc-pg__title-page" data-pg-title-page hidden></a>
			<span class="sc-pg-appbar__fill"></span>
			<details class="sc-pg-pop sc-pg-pop--compare" data-pg-compare hidden>
				<summary class="sc-pg-appbar__btn sc-pg__compare" aria-label="Compare with the model solution" title="Run your chart on the model solution's test inputs and compare the outputs">
					<Fragment set:html={pgIcons.compare} /><span class="sc-pg__compare-long">Compare with the model solution</span><span class="sc-pg__compare-short" aria-hidden="true">Compare</span><Fragment set:html={pgIcons.chevron} />
				</summary>
				<div class="sc-pg-pop__panel sc-pg-compare" role="group" aria-label="Comparison with the model solution" data-pg-compare-panel></div>
			</details>
			<ExamplesMenu groups={groups} count={items.length} />
			<button type="button" class="sc-pg-appbar__btn" data-pg-embed aria-haspopup="dialog" title="Put this chart on your own page: a web component or an iframe">
				<Fragment set:html={embedIcon} /><span class="sc-pg-appbar__label">Embed</span>
			</button>
			<button type="button" class="sc-pg-appbar__btn sc-pg-appbar__btn--share" data-action="share" title="Copy a link that contains this chart (every file of the project)">
				<Fragment set:html={pgIcons.link} /><span class="sc-pg-appbar__label">Copy link</span>
			</button>
			<span class="sc-pg-appbar__search" data-pg-search></span>
			{/* Starlight's search, moved out of its hidden header while the page is parsed (it brings its dialog and Ctrl+K). */}
			<script is:inline>
				;(() => {
					const slot = document.currentScript.previousElementSibling
					const search = document.querySelector('header site-search')
					if (search) slot.append(search)
				})()
			</script>
			<HelpMenu />
		</header>

		<TaskBanner exercises={exercises} />

		<div class="sc-pg__tabs" role="tablist" aria-label="Playground view" data-pg-tabs>
			<button type="button" role="tab" data-tab="code" aria-selected="true" aria-controls="sc-pg-editor-panel">Code</button>
			<button type="button" role="tab" data-tab="diagram" aria-selected="false" tabindex="-1" aria-controls="sc-pg-diagram-panel">Diagram</button>
			<button type="button" role="tab" data-tab="sim" aria-selected="false" tabindex="-1" aria-controls="sc-pg-panel-sim">Simulate</button>
		</div>

		<div class="sc-pg__work" data-pg-work>
			<aside class="sc-pg-files" id="sc-pg-files" data-pg-files aria-label="Files">
				<div class="sc-pg-files__tree" data-pg-files-tree>
					<div class="sc-pg-files__head"><h2 class="sc-pg-files__title">Files</h2></div>
					<ul class="sc-pg-files__list"><li class="sc-pg-files__item is-active"><span class="sc-pg-file" aria-current="true"><span class="sc-pg-file__glyph" aria-hidden="true"></span><span class="sc-pg-file__name" data-pg-static-file>{defaultFile}</span></span></li></ul>
				</div>
			</aside>
			<div class="sc-pg__fsplit" data-pg-fsplit role="separator" aria-orientation="vertical" aria-label="Resize the files" aria-controls="sc-pg-files" aria-valuemin="160" aria-valuemax="420" aria-valuenow="208" tabindex="0"></div>

			<div class="sc-pg__grid" data-pg-grid>
				<div class="sc-pg__top" data-pg-top>
					<section class="sc-pg__panel sc-pg__panel--editor" id="sc-pg-editor-panel" aria-label="Editor">
						<div class="sc-pg__filetabs" data-pg-file-tabs>
							<ul class="sc-pg-tabs"><li class="sc-pg-tabs__item is-active"><span class="sc-pg-tab" aria-current="true"><span class="sc-pg-file__glyph" aria-hidden="true"></span><span class="sc-pg-tab__name" data-pg-static-file>{defaultFile}</span></span></li></ul>
						</div>
						<div class="sc-pg__body sc-pg__body--editor" data-pg-editor>
							<pre class="sc-pg-static" data-pg-static><code>{lines.map((l, i) => <span class="sc-pg-static__line"><span class="sc-pg-static__no" aria-hidden="true">{i + 1}</span><span class="sc-pg-static__text" set:html={l || ' '} /></span>)}</code></pre>
						</div>
						<footer class="sc-pg__status" data-pg-problems data-state="pending">
							<button type="button" class="sc-pg__problems-toggle" data-pg-problems-toggle aria-controls="sc-pg-panel-problems" aria-disabled="true" title="The problems, in the panel below">
								<span class="sc-pg__problems-dot" aria-hidden="true"></span>
								<span class="sc-pg__problems-summary" data-pg-problems-summary><span class="sc-pg__if-js">Loading the compiler</span><span class="sc-pg__if-nojs">The editor, the live diagram and the simulator need JavaScript.</span></span>
							</button>
							<span class="sc-pg__meta" data-pg-cursor></span>
						</footer>
					</section>

					<div class="sc-pg__split" data-pg-split role="separator" aria-orientation="vertical" aria-label="Resize the editor and the diagram" aria-controls="sc-pg-editor-panel" aria-valuemin="20" aria-valuemax="80" aria-valuenow="50" tabindex="0"></div>

					<section class="sc-pg__panel sc-pg__panel--diagram" id="sc-pg-diagram-panel" aria-labelledby="sc-pg-diagram" data-pg-diagram>
						<header class="sc-pg__head">
							<h2 id="sc-pg-diagram">Diagram</h2>
							<span class="sc-pg__meta sc-pg__chart" data-pg-chart-name>{compiled.chart?.name}</span>
							<select class="sc-pg__chart-select" data-pg-chart hidden aria-label="The chart to show and simulate"></select>
							<div class="sc-pg__zoom" role="group" aria-label="Zoom">
								<button type="button" class="sc-pg__tool" data-action="zoom-out" aria-label="Zoom out" title="Zoom out (−)"><Fragment set:html={pgIcons.zoomOut} /></button>
								<button type="button" class="sc-pg__tool sc-pg__zoom-level" data-action="zoom-reset" data-pg-zoom title="Show at 100 % (1)">100 %</button>
								<button type="button" class="sc-pg__tool" data-action="zoom-in" aria-label="Zoom in" title="Zoom in (+)"><Fragment set:html={pgIcons.zoomIn} /></button>
								<button type="button" class="sc-pg__tool" data-action="fit" aria-label="Fit the whole diagram" title="Fit the whole diagram (0)"><Fragment set:html={pgIcons.fit} /></button>
								<button type="button" class="sc-pg__tool" data-action="outline" aria-label="Outline of the chart" title="Outline: the chart as a list" aria-expanded="false" aria-controls="sc-pg-outline"><Fragment set:html={pgIcons.outline} /></button>
								<button type="button" class="sc-pg__tool" data-action="export-svg" aria-label="Download the diagram as SVG" title="Download the diagram (SVG)"><Fragment set:html={pgIcons.image} /></button>
							</div>
						</header>
						<nav class="sc-pg-outline" id="sc-pg-outline" data-pg-outline aria-label="Outline of the chart" hidden></nav>
						<div class="sc-pg__body sc-pg__stage" data-pg-stage role="region" aria-roledescription="diagram" aria-label="Diagram. Arrow keys pan, plus and minus zoom, 0 fits it; drag to pan, Ctrl and the mouse wheel or a pinch zoom. The outline button lists its elements.">
							<div class="sc-pg__static-diagram" data-pg-static-diagram set:html={diagramSvg} />
							<span class="sc-pg__keys" id="sc-pg-diagram-keys" data-pg-diagram-keys hidden>Use the arrow keys to move between its states and transitions; Enter finds one in the source.</span>
							<p class="sc-pg__badge" data-pg-badge hidden>Showing the last diagram that parsed</p>
							<p class="sc-pg__busy" data-pg-busy hidden>Drawing the diagram</p>
							<p class="sc-pg__empty" data-pg-empty hidden><span>There is no <code>scchart</code> to draw yet.</span></p>
						</div>
					</section>
				</div>

				<div class="sc-pg__hsplit" data-pg-hsplit role="separator" aria-orientation="horizontal" aria-label="Resize the panel (Enter fits it to the simulation)" title="Drag to resize the panel; double-click to fit it to the simulation" aria-controls="sc-pg-panel-sim" aria-valuemin="0" aria-valuemax="100" aria-valuenow="40" tabindex="0"></div>

				<BottomPanel inputs={inputs} />
			</div>
		</div>
		<div class="sc-pg__toast" data-pg-toast role="status" hidden></div>
	</div>
</StarlightPage>

<script>
	import { bootPage } from '../components/playground/boot'
	import { wireEmbedButton } from '../components/embed/embed-button'
	bootPage()
	wireEmbedButton()
</script>
