---
/**
 * A pre-rendered diagram on the stage's graticule: fits the width of the frame, scrolls sideways when a wide
 * chart would become too small to read (renderSvg's minScale), and offers "Actual size" when it is shown
 * smaller than it was drawn. Optionally carries the chart's line map for hover linking with a code view
 * (`[data-sc-code="<key>"]` in the same frame).
 *
 * The script below enhances every diagram on the page: zoom, and hover / focus linking between diagram and
 * code (src/components/sim/link.ts). Simulations add their highlight classes on top.
 */
import type { LineMap } from '../sim/lines'
import '../../diagram/diagram.css'

interface Props {
	svg?: string
	/** Links this diagram with the code view of the same key. */
	key: string
	map?: LineMap
	root?: string
	/** Ids that keep is-focus (the Chart's `highlight`). */
	pinned?: string[]
	compact?: boolean
	/** Shown instead of a diagram when there is none (a chart that does not parse). */
	missing?: string
}
const { svg, key, map, root, pinned = [], compact = false, missing = 'This chart has no diagram: it does not parse.' } = Astro.props
const json = map ? JSON.stringify(map).replace(/</g, '\\u003c') : undefined
---

<div class:list={['sc-dview', { 'is-compact': compact }]} data-sc-diagram={key} data-pinned={pinned.join(' ') || undefined}>
	{
		svg ? (
			<div class="sc-dview__scroll">
				<Fragment set:html={svg} />
			</div>
		) : (
			<p class="sc-dview__missing">{missing}</p>
		)
	}
	{
		svg && (
			<button type="button" class="sc-dview__zoom sc-btn sc-btn--sm sc-btn--quiet" aria-pressed="false" hidden>
				<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
					<circle cx="7" cy="7" r="4.5" />
					<path d="m10.5 10.5 3.5 3.5M5 7h4" />
					<path d="M7 5v4" class="sc-dview__plus" />
				</svg>
				<span>Actual size</span>
			</button>
		)
	}
	{json && <script type="application/json" data-sc-map={key} data-root={root} set:html={json} />}
	{svg && <span class="sc-dview__keys" id={`${key}-keys`} hidden>Use the arrow keys to move between its states and transitions.</span>}
</div>

<script>
	import { enableCodeKeys, enableDiagramKeys, focusElements, linkHover, markCode, markErrors } from '../sim/link'
	import type { LineMap } from '../sim/lines'

	function zoom(view: HTMLElement) {
		const btn = view.querySelector<HTMLButtonElement>('.sc-dview__zoom')
		const svg = view.querySelector<SVGSVGElement>('svg.sc-diagram')
		if (!btn || !svg) return
		const natural = Number(svg.dataset.naturalWidth) || 0
		const label = btn.querySelector('span')!
		const update = () => {
			const zoomed = view.classList.contains('is-zoomed')
			const scale = svg.getBoundingClientRect().width / (natural || 1)
			btn.hidden = !zoomed && (scale > 0.85 || svg.getBoundingClientRect().width === 0)
			btn.setAttribute('aria-pressed', String(zoomed))
			label.textContent = zoomed ? 'Fit to width' : 'Actual size'
		}
		btn.addEventListener('click', () => {
			view.classList.toggle('is-zoomed')
			svg.style.width = view.classList.contains('is-zoomed') ? `${natural}px` : ''
			svg.style.maxWidth = view.classList.contains('is-zoomed') ? 'none' : `${natural}px`
			update()
		})
		new ResizeObserver(update).observe(view)
	}

	function link(view: HTMLElement) {
		const svg = view.querySelector<SVGSVGElement>('svg.sc-diagram')
		const script = view.querySelector<HTMLScriptElement>('script[data-sc-map]')
		const frame = view.closest('.sc-frame')
		let map: LineMap | undefined
		try {
			map = script?.textContent ? JSON.parse(script.textContent) : undefined
		} catch {
			map = undefined
		}
		const root = script?.dataset.root ?? svg?.dataset.chart ?? ''
		const hint = view.querySelector<HTMLElement>('.sc-dview__keys')
		// Keyboard and screen readers: the states and transitions, one tab stop, arrow keys between them.
		if (svg) enableDiagramKeys(svg, map, root, hint?.id)
		// A rejected chart's elements in question (drawn at build time): a marker beside each.
		if (svg?.querySelector('.is-error')) markErrors(svg)
		if (!script || !frame || !map) return
		const key = script.dataset.scMap!
		const code = frame.querySelector(`[data-sc-code="${CSS.escape(key)}"]`)
		const pinned = (view.dataset.pinned ?? '').split(' ').filter(Boolean)
		linkHover(view, code, map, root, pinned)
		if (code) enableCodeKeys(code)
		if (pinned.length) focusElements(svg, code, map, pinned)
	}

	function errors(code: HTMLElement) {
		const lines = (code.dataset.errorLines ?? '').split(' ').filter(Boolean).map(Number)
		if (lines.length) markCode(code, { error: lines })
	}

	function enhance(view: HTMLElement) {
		if (view.dataset.enhanced) return
		view.dataset.enhanced = ''
		zoom(view)
		link(view)
	}
	const run = () => {
		document.querySelectorAll<HTMLElement>('.sc-dview').forEach(enhance)
		document.querySelectorAll<HTMLElement>('[data-sc-code][data-error-lines]').forEach(errors)
	}
	run()
	document.addEventListener('astro:page-load', run)
</script>

<style>
	.sc-dview {
		position: relative;
		/* The stage's graticule: a faint dot grid, as on a scope screen. */
		background-image: radial-gradient(circle at 1px 1px, var(--c-rule) 1px, transparent 0);
		background-size: 16px 16px;
		background-position: 8px 8px;
	}
	.sc-dview__scroll {
		overflow-x: auto;
		padding: clamp(0.5rem, 2.5vw, 1.25rem);
		scrollbar-width: thin;
	}
	.sc-dview__scroll :global(svg.sc-diagram) {
		margin-inline: auto;
	}
	.sc-dview.is-zoomed .sc-dview__scroll :global(svg.sc-diagram) {
		margin-inline: 0;
	}
	.sc-dview__zoom {
		position: absolute;
		bottom: 0.5rem;
		right: 0.5rem;
		gap: 0.375rem;
		min-height: 1.75rem;
		padding-inline: 0.625rem;
		font-size: var(--text-xs);
	}
	.sc-dview__zoom[hidden] {
		display: none;
	}
	.sc-dview__zoom[aria-pressed='true'] .sc-dview__plus {
		display: none;
	}
	.sc-dview__missing {
		margin: 0;
		padding: 2rem var(--frame-pad, 1rem);
		color: var(--c-muted);
		font-size: var(--text-sm);
		text-align: center;
	}
</style>
