---
/**
 * The landing page's "What you'll learn": the Learn chapters as a chain of states, in reading order.
 * The first is drawn as an initial state (heavy outline), the last as a final state (double outline).
 * Titles and one-line descriptions come from the chapters' frontmatter, so the list follows the guide.
 */
import { getCollection } from 'astro:content'

const chapters = (await getCollection('docs', (e) => e.id.startsWith('learn/')))
	.sort((a, b) => (a.data.sidebar?.order ?? 99) - (b.data.sidebar?.order ?? 99))
	.map((e) => ({ href: `/${e.id}/`, title: e.data.title, description: e.data.description }))
const half = Math.ceil(chapters.length / 2)
---

<section class="sc-learnpath not-content" aria-labelledby="sc-learnpath-title" data-pagefind-ignore="all">
	<div class="sc-learnpath__intro">
		<h2 id="sc-learnpath-title" class="sc-landing-h2">What you’ll learn</h2>
		<p>
			Twelve chapters, read in order. Each one introduces a construct with a chart you can run, states the rule
			exactly, shows the mistakes beginners make, and ends with exercises.
		</p>
		<p>
			After that, <a href="/advanced/suspend/">Going further</a> covers the rest of the language and{' '}
			<a href="/patterns/abro/">Patterns</a> works through complete charts.
		</p>
	</div>
	<ol class="sc-learnpath__chain" style={`--half: ${half}`}>
		{
			chapters.map((c, i) => (
				<li class:list={{ 'is-first': i === 0, 'is-last': i === chapters.length - 1, 'is-col-end': i === half - 1 }}>
					<a href={c.href}>
						<span class="sc-learnpath__state" aria-hidden="true">
							{i + 1}
						</span>
						<span class="sc-learnpath__text">
							<span class="sc-learnpath__title">
								<span class="sc-visually-hidden">Chapter {i + 1}: </span>
								{c.title}
							</span>
							{c.description && <span class="sc-learnpath__desc">{c.description}</span>}
						</span>
					</a>
				</li>
			))
		}
	</ol>
</section>

<style>
	.sc-learnpath {
		display: grid;
		gap: 1.5rem 3rem;
		padding-block: 3rem;
		border-top: 1px solid var(--c-rule);
	}
	.sc-learnpath__intro p {
		margin-top: 0.75rem;
		max-width: 34rem;
		color: var(--c-text);
	}
	.sc-learnpath__intro a {
		color: var(--c-accent);
		text-underline-offset: 0.2em;
	}

	.sc-learnpath__chain {
		--node-w: 2.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
	}
	.sc-learnpath__chain li {
		position: relative;
		margin: 0;
	}
	/* The transition from this chapter to the next: a line down from the state, with an arrowhead. */
	.sc-learnpath__chain li:not(.is-last)::before {
		content: '';
		position: absolute;
		inset-inline-start: calc(var(--node-w) / 2 - 0.75px);
		top: 2.125rem;
		bottom: -0.125rem;
		width: 1.5px;
		background-color: var(--sc-edge);
		opacity: 0.5;
	}
	.sc-learnpath__chain li:not(.is-last)::after {
		content: '';
		position: absolute;
		inset-inline-start: calc(var(--node-w) / 2 - 4px);
		bottom: -0.0625rem;
		border: 4px solid transparent;
		border-top: 6px solid var(--sc-edge);
		border-bottom: 0;
		opacity: 0.5;
	}
	.sc-learnpath__chain a {
		display: grid;
		grid-template-columns: var(--node-w) minmax(0, 1fr);
		gap: 0.875rem;
		padding-block: 0.25rem 1.125rem;
		color: inherit;
		text-decoration: none;
	}
	.sc-learnpath__state {
		display: grid;
		place-items: center;
		width: var(--node-w);
		height: 1.75rem;
		margin-top: 0.125rem;
		border-radius: var(--radius-capsule);
		border: 1.5px solid var(--sc-state-stroke);
		background: linear-gradient(180deg, var(--sc-state-fill), var(--sc-state-fill-end));
		color: var(--sc-state-text);
		font-size: var(--text-xs);
		font-weight: 800;
		font-variant-numeric: tabular-nums;
	}
	.is-first .sc-learnpath__state {
		border-width: 3px;
	}
	.is-last .sc-learnpath__state {
		box-shadow:
			0 0 0 2px var(--c-paper),
			0 0 0 3.5px var(--sc-state-stroke);
	}
	.sc-learnpath__text {
		display: grid;
		gap: 0.125rem;
	}
	.sc-learnpath__title {
		font-weight: 700;
		color: var(--c-ink);
		line-height: 1.35;
	}
	.sc-learnpath__desc {
		font-size: var(--text-sm);
		line-height: 1.45;
		color: var(--c-muted);
	}
	.sc-learnpath__chain a:hover .sc-learnpath__title {
		color: var(--c-accent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.sc-learnpath__chain a:hover .sc-learnpath__state {
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--sc-state-fill-end) 60%, transparent);
	}
	.sc-learnpath__chain .is-last a:hover .sc-learnpath__state {
		box-shadow:
			0 0 0 2px var(--c-paper),
			0 0 0 3.5px var(--sc-state-stroke),
			0 0 0 7px color-mix(in srgb, var(--sc-state-fill-end) 60%, transparent);
	}

	@media (min-width: 48rem) {
		.sc-learnpath__chain {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-rows: repeat(var(--half), auto);
			grid-auto-flow: column;
			column-gap: 2rem;
		}
		/* The chain continues at the top of the second column; the line stops at the column's end. */
		.sc-learnpath__chain li.is-col-end::before,
		.sc-learnpath__chain li.is-col-end::after {
			display: none;
		}
	}
	@media (min-width: 72rem) {
		.sc-learnpath {
			grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
		}
	}
</style>
