---
/**
 * <KeyIdeas>…a Markdown list…</KeyIdeas>: the summary at the end of a chapter.
 *
 * Drawn as KIELER draws a final state (a double outline): the chapter ends here.
 */
import { nextId } from './frame/ids'

interface Props {
	title?: string
}
const { title = 'Key ideas' } = Astro.props
const id = nextId('sck-')
---

<section class="sc-keyideas not-content" aria-labelledby={id}>
	<h2 class="sc-keyideas__title" id={id}>{title}</h2>
	<div class="sc-keyideas__body">
		<slot />
	</div>
</section>

<style>
	.sc-keyideas {
		position: relative;
		margin-block: 2.75rem 1rem;
		max-width: var(--measure);
		padding: 1.25rem 1.5rem 1.375rem;
		border: 1.5px solid var(--sc-state-stroke);
		border-radius: 1.25rem;
		background: linear-gradient(180deg, var(--sc-superstate-fill), var(--sc-superstate-fill-end));
	}
	/* The inner line of the final state's double outline. */
	.sc-keyideas::before {
		content: '';
		position: absolute;
		inset: 4px;
		border: 1.5px solid var(--sc-state-stroke);
		border-radius: calc(1.25rem - 4px);
		pointer-events: none;
	}
	.sc-keyideas__title {
		margin: 0;
		font-size: var(--text-lg);
		font-weight: 700;
		line-height: 1.3;
		color: var(--c-ink);
	}
	/* The summary comes from MDX: style its prose here (the box is outside Starlight's prose rules). */
	.sc-keyideas__body {
		margin-top: 0.625rem;
		color: var(--c-text);
	}
	.sc-keyideas__body :global(* + *) {
		margin-top: 0.625rem;
	}
	.sc-keyideas__body :global(ul),
	.sc-keyideas__body :global(ol) {
		margin-bottom: 0;
		padding-inline-start: 1.25rem;
	}
	.sc-keyideas__body :global(li + li) {
		margin-top: 0.5rem;
	}
	.sc-keyideas__body :global(li::marker) {
		color: var(--c-muted);
	}
	.sc-keyideas__body :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		padding: 0.05em 0.3em;
		border-radius: var(--radius-xs);
		background-color: color-mix(in srgb, var(--sl-color-bg-inline-code) 70%, transparent);
		color: var(--c-ink);
	}
	.sc-keyideas__body :global(strong) {
		color: var(--c-ink);
	}
	.sc-keyideas__body :global(a) {
		color: var(--c-accent);
	}
</style>
