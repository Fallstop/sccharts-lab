---
/**
 * Starlight's SiteTitle, replaced: the mark, "SCCharts Lab" in the display face, and the subtitle.
 * The subtitle hides on narrow screens, where the header also holds search and the menu button.
 */
import LogoMark from './LogoMark.astro'

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute
---

<a href={siteTitleHref} class="sc-site-title" translate="no">
	<LogoMark size={30} />
	<span class="sc-site-title__name">{siteTitle}</span>
	<span class="sc-site-title__sub">guide and playground</span>
</a>

<style>
	.sc-site-title {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		min-width: 0;
		color: var(--c-ink);
		text-decoration: none;
		white-space: nowrap;
	}
	.sc-site-title__name {
		font-family: var(--font-display);
		font-stretch: var(--display-stretch);
		font-weight: 650;
		font-size: 1.1875rem;
		letter-spacing: -0.01em;
		line-height: 1;
	}
	.sc-site-title__sub {
		display: none;
		align-self: center;
		padding-inline-start: 0.625rem;
		border-inline-start: 1px solid var(--c-rule-strong);
		font-size: var(--text-sm);
		line-height: 1.2;
		color: var(--c-muted);
	}
	.sc-site-title:hover .sc-site-title__name {
		color: var(--c-accent);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.3em;
	}
	.sc-site-title:focus-visible {
		outline-offset: 4px;
		border-radius: 2px;
	}
	@media (min-width: 34em) {
		.sc-site-title__sub {
			display: inline;
		}
	}
</style>

<style is:global>
	/* Header chrome. Starlight draws a divider after the social links even when there are none, which left
	 * a stray rule at the header's end; with no links there is nothing to divide. */
	header.header .social-icons:empty {
		display: none;
	}
</style>
