---
/**
 * Starlight's Footer, with "Report a mistake on this page" above it when REPORT_URL (src/components/site.ts) is
 * set, except on the 404 page (its own text links to reporting a broken link). Without it, this is exactly
 * Starlight's footer.
 */
import Default from '@astrojs/starlight/components/Footer.astro'
import { REPORT_URL, reportHref } from '../site'

const route = Astro.locals.starlightRoute
const href = route.id === '404' ? undefined : reportHref(REPORT_URL, Astro.url.href, route.entry.data.title)
---

{
	href && (
		<p class="sc-report">
			<a href={href}>Report a mistake on this page</a>
		</p>
	)
}
<Default />

<style>
	.sc-report {
		margin-top: 3rem;
		font-size: var(--sl-text-sm);
		color: var(--c-muted);
	}
	.sc-report a {
		color: var(--c-muted);
		text-decoration-line: underline;
		text-decoration-color: var(--c-rule-strong);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}
	.sc-report a:hover {
		color: var(--c-accent);
		text-decoration-color: currentColor;
	}
	.sc-report + :global(footer) :global(.meta) {
		margin-top: 1rem;
	}
</style>
