{
  "name": "sccharts-lab",
  "displayName": "SCCharts Lab",
  "description": "Edit, visualise, simulate tick by tick, and debug SCCharts models in VS Code. Independent fork of the KIELER VS Code extension (keith-vscode).",
  "version": "0.9.4",
  "publisher": "qinnovate",
  "author": "Jasper Miller-Waugh",
  "contributors": [
    "KIELER <kieler@rtsys.informatik.uni-kiel.de>"
  ],
  "icon": "icon.png",
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fallstop/sccharts-lab"
  },
  "bugs": {
    "url": "https://github.com/Fallstop/sccharts-lab/issues"
  },
  "homepage": "https://github.com/Fallstop/sccharts-lab#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "sccharts",
    "kieler",
    "statecharts",
    "synchronous",
    "simulation"
  ],
  "activationEvents": [
    "onLanguage:sctx",
    "onLanguage:scl",
    "onLanguage:kico"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sctx",
        "aliases": [
          "SCTX",
          "sctx"
        ],
        "extensions": [
          "sctx"
        ],
        "configuration": "./configurations/language-configuration.json"
      },
      {
        "id": "scl",
        "aliases": [
          "SCL",
          "scl"
        ],
        "extensions": [
          "scl"
        ],
        "configuration": "./configurations/language-configuration.json"
      },
      {
        "id": "kico",
        "aliases": [
          "KiCo compilation system",
          "kico"
        ],
        "extensions": [
          "kico"
        ],
        "configuration": "./configurations/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sctx",
        "scopeName": "text.sctx",
        "path": "./syntaxes/sctx.tmLanguage.json"
      },
      {
        "language": "scl",
        "scopeName": "text.scl",
        "path": "./syntaxes/scl.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "keith-vscode.compile",
        "title": "Compile current model with...",
        "icon": "$(server-process)",
        "category": "KiCo"
      },
      {
        "command": "keith-vscode.kico.newSystem",
        "title": "New compilation system (.kico) in workspace",
        "icon": "$(new-file)",
        "category": "KiCo"
      },
      {
        "command": "keith-vscode.compile-snapshot",
        "title": "Compile diagram model with...",
        "icon": "$(server-process)",
        "category": "KiCo"
      },
      {
        "command": "keith-vscode.show-stage",
        "title": "Show Compilation Stage...",
        "icon": "$(list-tree)"
      },
      {
        "command": "keith-vscode.show-model",
        "title": "Show Model in Diagram",
        "icon": "$(arrow-left)"
      },
      {
        "command": "keith-vscode.auto-compile",
        "title": "Set auto-compile to ...",
        "category": "KiCo"
      },
      {
        "command": "keith-vscode.show-resulting-model",
        "title": "Show model after compile?",
        "category": "KiCo"
      },
      {
        "command": "keith-vscode.show-private-systems",
        "title": "Show private systems?",
        "category": "KiCo"
      },
      {
        "command": "keith-vscode.inplace",
        "title": "Set inplace compilation to ...",
        "category": "KiCo"
      },
      {
        "command": "keith-vscode.show-next",
        "title": "Show next",
        "category": "KiCo"
      },
      {
        "command": "keith-vscode.show-previous",
        "title": "Show previous",
        "category": "KiCo"
      },
      {
        "command": "keith-vscode.request-compilation-systems",
        "title": "Request compilation systems",
        "category": "KiCo"
      },
      {
        "command": "keith-vscode.compilation-time",
        "title": "Show compilation duration ...",
        "category": "KiCo"
      },
      {
        "command": "keith-vscode.simulate",
        "title": "Simulate current model with...",
        "icon": "$(play)",
        "category": "Simulation"
      },
      {
        "command": "keith-vscode.simulate-snapshot",
        "title": "Simulate current diagram model with...",
        "icon": "$(play)",
        "category": "Simulation"
      },
      {
        "command": "keith-vscode.simulation-stop",
        "title": "Stop simulation",
        "category": "Simulation",
        "icon": "$(debug-stop)"
      },
      {
        "command": "keith-vscode.simulation-step",
        "title": "Execute simulation step",
        "category": "Simulation",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "keith-vscode.simulation-run",
        "title": "Run simulation",
        "category": "Simulation",
        "icon": "$(debug-continue)"
      },
      {
        "command": "keith-vscode.simulation-pause",
        "title": "Pause simulation",
        "category": "Simulation",
        "icon": "$(debug-pause)"
      },
      {
        "command": "keith-vscode.simulation-restart",
        "title": "Restart simulation",
        "category": "Simulation",
        "icon": "$(debug-restart)"
      },
      {
        "command": "keith-vscode.simulation-rebuild",
        "title": "Rebuild and Restart Simulation",
        "icon": "$(sync)"
      },
      {
        "command": "keith-vscode.simulation-save-trace",
        "title": "Save trace",
        "category": "Simulation"
      },
      {
        "command": "keith-vscode.simulation-load-trace",
        "title": "Load trace",
        "category": "Simulation"
      },
      {
        "command": "keith-vscode.simulation-step-back",
        "title": "Step back one tick",
        "category": "Simulation",
        "icon": "$(debug-step-back)"
      },
      {
        "command": "keith-vscode.simulation-run-to-breakpoint",
        "title": "Run to breakpoint",
        "category": "Simulation",
        "icon": "$(debug-continue)"
      },
      {
        "command": "keith-vscode.simulation-add-breakpoint",
        "title": "Add simulation breakpoint...",
        "category": "Simulation",
        "icon": "$(debug-breakpoint-conditional)"
      },
      {
        "command": "keith-vscode.simulation-add-watch",
        "title": "Add simulation watch expression...",
        "category": "Simulation",
        "icon": "$(eye)"
      },
      {
        "command": "keith-vscode.simulation-step-delay",
        "title": "Set simulation step delay to ...",
        "category": "Simulation"
      },
      {
        "command": "keith-vscode.simulation-type",
        "title": "Set simulation type to ...",
        "category": "Simulation"
      },
      {
        "command": "keith-vscode.show-internal-variables",
        "title": "Set display internal variables to ...",
        "category": "Simulation"
      },
      {
        "command": "keith-vscode.restart-language-server",
        "title": "Restart KIELER language server",
        "icon": "$(debug-restart)",
        "category": "KIELER"
      },
      {
        "command": "keith-vscode.diagram.restart",
        "title": "Restart diagram",
        "icon": "$(debug-restart)",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.diagram.center",
        "title": "Center diagram selection",
        "icon": "$(location)",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.diagram.fit",
        "title": "Fit diagram to viewport",
        "icon": "$(move)",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.diagram.layout",
        "title": "Layout the diagram to fit the new viewport",
        "icon": "$(editor-layout)",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.diagram.refresh",
        "title": "Refresh the diagram",
        "icon": "$(refresh)",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.diagram.export",
        "title": "Export diagram to SVG",
        "icon": "$(clone)",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.diagram.sync",
        "title": "Enable Sync With Editor",
        "enablement": "!keith-vscode.syncWithEditor",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.diagram.noSync",
        "title": "Disable Sync With Editor",
        "enablement": "keith-vscode.syncWithEditor",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.diagram.data.clear",
        "title": "Clear Persisted Diagram Data",
        "icon": "$(clear-all)",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.diagram.debugOptions",
        "title": "Activate Diagram Debug Options",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.diagram.open",
        "title": "Open Diagram Preview",
        "icon": "$(open-preview)",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.diagram.revealCursor",
        "title": "Reveal Cursor in Diagram",
        "icon": "$(target)",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.generate-code",
        "title": "Generate Code...",
        "category": "SCCharts",
        "icon": "$(code)"
      },
      {
        "command": "keith-vscode.hide-warnings",
        "title": "Hide Compiler Warnings",
        "category": "SCCharts",
        "icon": "$(eye-closed)"
      },
      {
        "command": "keith-vscode.show-warnings",
        "title": "Show Compiler Warnings",
        "category": "SCCharts",
        "icon": "$(eye)"
      },
      {
        "command": "keith-vscode.save-generated-code",
        "title": "Save Generated File As...",
        "category": "SCCharts",
        "icon": "$(save)"
      },
      {
        "command": "keith-vscode.save-all-generated-code",
        "title": "Save All Generated Files...",
        "category": "SCCharts",
        "icon": "$(save-all)"
      },
      {
        "command": "keith-vscode.runtime.showInfo",
        "title": "Show Java runtime and C compiler in use",
        "category": "SCCharts Lab"
      },
      {
        "command": "keith-vscode.runtime.downloadCToolchain",
        "title": "Download C toolchain (w64devkit, Windows)",
        "category": "SCCharts Lab"
      },
      {
        "command": "keith-vscode.runtime.removeCToolchain",
        "title": "Remove downloaded C toolchain",
        "category": "SCCharts Lab"
      },
      {
        "command": "keith-vscode.runtime.clearStartupCache",
        "title": "Clear language server startup cache",
        "category": "SCCharts Lab"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "when": "!keith.vscode:warningsHidden",
          "command": "keith-vscode.hide-warnings"
        },
        {
          "when": "keith.vscode:warningsHidden",
          "command": "keith-vscode.show-warnings"
        },
        {
          "when": "keith.vscode:compilationReady && resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.compile"
        },
        {
          "when": "keith.vscode:compilationReady && resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.compile-snapshot"
        },
        {
          "when": "keith.vscode:compilationReady && resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.show-stage"
        },
        {
          "when": "keith-vscode.diagramOpen",
          "command": "keith-vscode.show-model"
        },
        {
          "command": "keith-vscode.auto-compile"
        },
        {
          "command": "keith-vscode.show-resulting-model"
        },
        {
          "command": "keith-vscode.show-private-systems"
        },
        {
          "command": "keith-vscode.inplace"
        },
        {
          "command": "keith-vscode.show-next"
        },
        {
          "command": "keith-vscode.show-previous"
        },
        {
          "command": "keith-vscode.request-compilation-systems"
        },
        {
          "command": "keith-vscode.compilation-time"
        },
        {
          "when": "keith.vscode:compilationReady && resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.simulate"
        },
        {
          "when": "keith.vscode:compilationReady && resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.simulate-snapshot"
        },
        {
          "command": "keith-vscode.simulation-stop",
          "when": "keith.vscode:simulationRunning"
        },
        {
          "command": "keith-vscode.simulation-step",
          "when": "keith.vscode:simulationRunning"
        },
        {
          "command": "keith-vscode.simulation-run",
          "when": "keith.vscode:simulationRunning"
        },
        {
          "command": "keith-vscode.simulation-pause",
          "when": "keith.vscode:simulationRunning"
        },
        {
          "command": "keith-vscode.simulation-restart",
          "when": "!keith.vscode:simulationRunning"
        },
        {
          "command": "keith-vscode.simulation-rebuild",
          "when": "keith.vscode:simulationRunning"
        },
        {
          "command": "keith-vscode.simulation-save-trace",
          "when": "keith.vscode:simulationRunning"
        },
        {
          "command": "keith-vscode.simulation-load-trace",
          "when": "keith.vscode:simulationRunning"
        },
        {
          "command": "keith-vscode.simulation-step-back",
          "when": "keith.vscode:simulationRunning"
        },
        {
          "command": "keith-vscode.simulation-run-to-breakpoint",
          "when": "keith.vscode:simulationRunning"
        },
        {
          "command": "keith-vscode.simulation-add-breakpoint",
          "when": "keith.vscode:simulationRunning"
        },
        {
          "command": "keith-vscode.simulation-add-watch",
          "when": "keith.vscode:simulationRunning"
        },
        {
          "command": "keith-vscode.restart-language-server"
        },
        {
          "command": "keith-vscode.diagram.data.clear"
        },
        {
          "command": "keith-vscode.diagram.debugOptions"
        },
        {
          "command": "keith-vscode.diagram.restart"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.diagram.center"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.diagram.fit"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.diagram.layout"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.diagram.refresh"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.diagram.export"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.diagram.sync"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.diagram.noSync"
        },
        {
          "command": "keith-vscode.generate-code",
          "when": "resourceLangId == sctx && resourceScheme == file"
        },
        {
          "command": "keith-vscode.save-generated-code",
          "when": "resourceScheme == sccharts-generated"
        },
        {
          "command": "keith-vscode.save-all-generated-code",
          "when": "resourceScheme == sccharts-generated"
        },
        {
          "command": "keith-vscode.runtime.showInfo"
        },
        {
          "command": "keith-vscode.runtime.downloadCToolchain",
          "when": "isWindows"
        },
        {
          "command": "keith-vscode.runtime.removeCToolchain",
          "when": "isWindows"
        },
        {
          "command": "keith-vscode.runtime.clearStartupCache"
        }
      ],
      "editor/title": [
        {
          "when": "keith.vscode:compilationReady && resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.compile",
          "group": "navigation@1"
        },
        {
          "when": "keith.vscode:compilationReady && resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.simulate",
          "group": "navigation@2"
        },
        {
          "when": "resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.diagram.open",
          "group": "navigation@1"
        },
        {
          "when": "keith.vscode:compilationReady && resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.show-stage",
          "group": "2_codegen@2"
        },
        {
          "when": "resourceLangId == sctx && !keith.vscode:warningsHidden",
          "command": "keith-vscode.hide-warnings",
          "group": "3_warnings@1"
        },
        {
          "when": "resourceLangId == sctx && keith.vscode:warningsHidden",
          "command": "keith-vscode.show-warnings",
          "group": "3_warnings@1"
        },
        {
          "command": "keith-vscode.simulation-step",
          "when": "keith.vscode:simulationRunning && (keith-diagram-focused || resourceLangId == sctx)",
          "group": "navigation@11"
        },
        {
          "command": "keith-vscode.simulation-run",
          "when": "keith.vscode:simulationRunning && (keith-diagram-focused || resourceLangId == sctx) && !keith.vscode:play",
          "group": "navigation@12"
        },
        {
          "command": "keith-vscode.simulation-pause",
          "when": "keith.vscode:simulationRunning && (keith-diagram-focused || resourceLangId == sctx) && keith.vscode:play",
          "group": "navigation@12"
        },
        {
          "command": "keith-vscode.simulation-stop",
          "when": "keith.vscode:simulationRunning && (keith-diagram-focused || resourceLangId == sctx)",
          "group": "navigation@13"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.diagram.restart",
          "group": "navigation@0"
        },
        {
          "when": "keith-diagram-focused && keith-vscode.syncWithEditor",
          "command": "keith-vscode.diagram.refresh",
          "group": "navigation@1"
        },
        {
          "when": "keith-diagram-focused && keith-vscode.syncWithEditor",
          "command": "keith-vscode.diagram.fit",
          "group": "navigation@2"
        },
        {
          "when": "keith-diagram-focused && !keith-vscode.syncWithEditor",
          "command": "keith-vscode.diagram.sync",
          "group": "2_diagram-controls@1"
        },
        {
          "when": "keith-diagram-focused && keith-vscode.syncWithEditor",
          "command": "keith-vscode.diagram.noSync",
          "group": "2_diagram-controls@1"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.diagram.export",
          "group": "2_diagram-controls@2"
        },
        {
          "command": "keith-vscode.generate-code",
          "when": "resourceLangId == sctx && resourceScheme == file",
          "group": "navigation@3"
        },
        {
          "command": "keith-vscode.save-generated-code",
          "when": "resourceScheme == sccharts-generated",
          "group": "navigation@1"
        },
        {
          "command": "keith-vscode.save-all-generated-code",
          "when": "resourceScheme == sccharts-generated",
          "group": "navigation@2"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.restart-language-server",
          "group": "9_restart"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.show-stage",
          "group": "2_diagram-controls@3"
        }
      ],
      "editor/context": [
        {
          "when": "resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.diagram.open",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == sctx && keith-vscode.diagramOpen",
          "command": "keith-vscode.diagram.revealCursor",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == sctx && keith.vscode:simulationRunning",
          "command": "keith-vscode.simulation-add-breakpoint",
          "group": "simulation@1"
        },
        {
          "when": "resourceLangId == sctx && keith.vscode:simulationRunning",
          "command": "keith-vscode.simulation-add-watch",
          "group": "simulation@2"
        },
        {
          "when": "resourceLangId == sctx && !keith.vscode:warningsHidden",
          "command": "keith-vscode.hide-warnings",
          "group": "warnings@1"
        },
        {
          "when": "resourceLangId == sctx && keith.vscode:warningsHidden",
          "command": "keith-vscode.show-warnings",
          "group": "warnings@1"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.diagram.open",
          "group": "navigation"
        },
        {
          "command": "keith-vscode.generate-code",
          "when": "resourceExtname == .sctx && resourceScheme == file",
          "group": "2_codegen"
        }
      ]
    },
    "configuration": {
      "title": "SCCharts Lab",
      "properties": {
        "keith-vscode.autocompile.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Specifies whether compilations shall happen on save."
        },
        "keith-vscode.compileInplace.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Specifies whether compilations shall happen in place."
        },
        "keith-vscode.showResultingModel.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Specifies whether the model of the compilation shall be shown after compilation."
        },
        "keith-vscode.showPrivateSystems.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Specifies whether private compilation systems shall be shown."
        },
        "keith-vscode.simulationStepDelay": {
          "type": "integer",
          "minimum": 0,
          "default": 200,
          "description": "Time in milliseconds to wait till next simulation step is requested in play mode."
        },
        "keith-vscode.simulationType": {
          "type": "string",
          "default": "Periodic",
          "description": "The currently selected simulation type.",
          "enum": [
            "Periodic",
            "Manual",
            "Dynamic"
          ]
        },
        "keith-vscode.showInternalVariables.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Specifies whether internal variables shall be shown in the simulation widget (e.g. guards, ...)."
        },
        "keith-vscode.liveDiagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Analyse SCCharts while typing: scheduling cycles, instantaneous loops and other compiler findings appear as squiggles without compiling."
        },
        "keith-vscode.liveDiagnostics.debounceMs": {
          "type": "integer",
          "minimum": 0,
          "default": 400,
          "description": "How long to wait after the last edit before the live analysis runs, in milliseconds."
        },
        "keith-vscode.diagnostics.showWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Show the compiler's warnings as squiggles in the editor, from a compile and from the live analysis. Errors are always shown."
        },
        "keith-vscode.diagramColorTheme": {
          "type": "string",
          "default": "light",
          "enum": [
            "light",
            "editor"
          ],
          "enumDescriptions": [
            "Always draw diagrams with KIELER's light palette (default).",
            "Follow the VS Code colour theme: KIELER's dark palette on dark themes."
          ],
          "description": "Colour palette of the SCCharts diagrams. Applies to open diagrams immediately."
        },
        "keith-vscode.javaHome": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Java installation (JDK or JRE, version 21 or newer) to run the SCCharts language server with. Leave empty to use the runtime bundled with platform builds of the extension, then `JDK_HOME`, `JAVA_HOME` and finally `java` on PATH. Java simulation needs a JDK here because it compiles with `javac`. Takes effect on the next server restart or window reload."
        },
        "keith-vscode.diagram.followCursor": {
          "type": "string",
          "enum": [
            "off",
            "focus",
            "expand"
          ],
          "enumDescriptions": [
            "The diagram does not follow the editor cursor.",
            "Expand the regions around the cursor and select the state, region or transition under it.",
            "Additionally collapse the regions the cursor is not in, unless you expanded them yourself and \"Remember Collapsed/Expanded Regions\" is on."
          ],
          "default": "focus",
          "description": "Follow the editor cursor in the open diagram of the same SCChart (the Eclipse editor's smart collapse). The command \"Reveal Cursor in Diagram\" does this once, even when off."
        },
        "keith-vscode.diagram.selectText": {
          "type": "boolean",
          "default": true,
          "description": "Selecting a state, region or transition in the diagram selects its text in the open editor."
        },
        "keith-vscode.cCompilerPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "C compiler for C simulation and code checks, as a full path or a program name on PATH (GCC-compatible command line). Leave empty to use the toolchain downloaded by SCCharts Lab on Windows, or `gcc` on PATH. Takes effect on the next server restart."
        },
        "keith-vscode.compilationSystems.folders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Extra directories scanned for `.kico` compilation systems, absolute or relative to each workspace folder, in addition to the workspace itself (every `.kico` in the workspace outside build and dependency folders is loaded automatically). Systems from these files appear in **Compile current model with...** and take effect as soon as the file is saved."
        },
        "keith-vscode.startupCache.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine-overridable",
          "markdownDescription": "Start the language server from a class-data-sharing archive (AppCDS). The archive is built on this machine over the first two server starts and cuts the following starts by about a third. Turn off if a JVM crash at start points at the archive; \"Clear language server startup cache\" rebuilds it."
        }
      }
    },
    "keybindings": [
      {
        "command": "keith-vscode.simulation-step",
        "key": "ctrl+alt+s",
        "when": "keith.vscode:simulationRunning"
      },
      {
        "command": "keith-vscode.simulation-run",
        "key": "ctrl+alt+r",
        "when": "keith.vscode:simulationRunning && !keith.vscode:play"
      },
      {
        "command": "keith-vscode.simulation-pause",
        "key": "ctrl+alt+r",
        "when": "keith.vscode:simulationRunning && keith.vscode:play"
      },
      {
        "command": "keith-vscode.simulation-stop",
        "key": "ctrl+alt+x",
        "when": "keith.vscode:simulationRunning"
      },
      {
        "command": "keith-vscode.diagram.restart",
        "key": "ctrl+alt+d",
        "when": "keith-diagram-focused || keith-vscode.diagramOpen"
      },
      {
        "command": "keith-vscode.diagram.open",
        "key": "ctrl+alt+v",
        "when": "resourceLangId in keith-vscode.languages"
      }
    ]
  },
  "scripts": {
    "clean": "rimraf dist pack",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "test": "node --test test/*.test.cjs",
    "test:server": "node test/server-smoke.cjs && node test/server-diagnostics.cjs && node test/server-codegen.cjs && node test/server-live-diagnostics.cjs && node test/server-highlight.cjs && node test/server-cursor-sync.cjs && node test/server-compile-ide.cjs && node test/server-startup.cjs && node test/server-simulation-debug.cjs && node test/server-workspace-kico.cjs && node test/server-completion.cjs",
    "build": "webpack --mode production",
    "watch": "webpack --watch",
    "package": "node scripts/package-extension.cjs",
    "package:platform": "node scripts/package-extension.cjs",
    "vscode:prepublish": "yarn run build",
    "vscode:uninstall": "node ./scripts/uninstall.cjs",
    "build:server": "node scripts/build-server.cjs --required",
    "build:jre": "node scripts/build-jre.cjs --host"
  },
